/**
 * @fileoverview Firestore Security Rules for the SecureHaul application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict ownership model for user-related data and a
 * public-read, owner-write model for loads.  Authorization independence is
 * achieved through data denormalization.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles.
 * - /users/{userId}/verification_documents/{documentId}: Stores verification documents for each user.
 * - /users/{userId}/subscriptions/{subscriptionId}: Stores subscription information for each user.
 * - /drivers/{driverId}: Stores driver profiles
 * - /drivers/{driverId}/trucks/{truckId}: Stores truck information associated with each driver
 * - /loads/{loadId}: Stores load postings. Includes shipperId for authorization.
 * - /loads/{loadId}/bids/{bidId}: Stores bids for each load. Includes carrierId and loadId for authorization.
 * - /trucks/{truckId}/emergency_alerts/{alertId}: Stores emergency alerts for each truck.
 * - /shippers/{shipperId}: Stores shipper profiles
 * - /carriers/{carrierId}: Stores carrier profiles
 * - /freight_managers/{freightManagerId}: Stores freight manager profiles
 *
 * Key Security Decisions:
 * - Users can only access their own data under /users/{userId}.
 * - Loads are publicly readable, but only the owner (shipper) can create, update, or delete them.
 * - Listing of verification documents and subscriptions is allowed only for the owner.
 *
 * Denormalization for Authorization:
 * - Loads: Each /loads/{loadId} document includes the shipperId of the user who created it. This allows load ownership to be validated without additional reads.
 * - Bids: Each /loads/{loadId}/bids/{bidId} document includes the carrierId and loadId. This allows bid ownership to be validated without additional reads.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the user is signed in
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper function to check if the user is the owner of the resource
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Helper function to check if the user is the owner of the existing resource
    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }

    /**
     * @description Grants access to user profiles.
     * @path /users/{userId}
     * @allow (create) User with ID 'user123' can create their profile.
     * @allow (get) User with ID 'user123' can read their profile.
     * @allow (update) User with ID 'user123' can update their profile.
     * @allow (delete) User with ID 'user123' can delete their profile.
     * @deny (create) User with ID 'user456' cannot create a profile with ID 'user123'.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Grants access to verification documents for each user.
     * @path /users/{userId}/verification_documents/{documentId}
     * @allow (create) User with ID 'user123' can create a verification document.
     * @allow (get) User with ID 'user123' can read their verification document.
     * @allow (update) User with ID 'user123' can update their verification document.
     * @allow (delete) User with ID 'user123' can delete their verification document.
     * @deny (create) User with ID 'user456' cannot create a verification document for user 'user123'.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId}/verification_documents/{documentId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Grants access to subscription information for each user.
     * @path /users/{userId}/subscriptions/{subscriptionId}
     * @allow (create) User with ID 'user123' can create their subscription.
     * @allow (get) User with ID 'user123' can read their subscription.
     * @allow (update) User with ID 'user123' can update their subscription.
     * @allow (delete) User with ID 'user123' can delete their subscription.
     * @deny (create) User with ID 'user456' cannot create a subscription for user 'user123'.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId}/subscriptions/{subscriptionId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Grants access to driver profiles.
     * @path /drivers/{driverId}
     * @allow (create) User with ID 'driver123' can create their driver profile.
     * @allow (get) User with ID 'driver123' can read their driver profile.
     * @allow (update) User with ID 'driver123' can update their driver profile.
     * @allow (delete) User with ID 'driver123' can delete their driver profile.
     * @deny (create) User with ID 'user456' cannot create a driver profile with ID 'driver123'.
     * @principle Enforces document ownership for writes.
     */
    match /drivers/{driverId} {
      allow get: if isSignedIn() && isOwner(driverId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(driverId) && request.resource.data.id == driverId;
      allow update: if isExistingOwner(driverId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(driverId);
    }

    /**
     * @description Grants access to truck information associated with each driver.
     * @path /drivers/{driverId}/trucks/{truckId}
     * @allow (create) Driver with ID 'driver123' can create a truck.
     * @allow (get) Driver with ID 'driver123' can read their truck.
     * @allow (update) Driver with ID 'driver123' can update their truck.
     * @allow (delete) Driver with ID 'driver123' can delete their truck.
     * @deny (create) User with ID 'user456' cannot create a truck for driver 'driver123'.
     * @principle Enforces document ownership for writes.
     */
    match /drivers/{driverId}/trucks/{truckId} {
      allow get: if isSignedIn() && isOwner(driverId);
      allow list: if isSignedIn() && isOwner(driverId);
      allow create: if isSignedIn() && isOwner(driverId) && request.resource.data.driverId == driverId;
      allow update: if isExistingOwner(driverId) && request.resource.data.driverId == resource.data.driverId;
      allow delete: if isExistingOwner(driverId);
    }

    /**
     * @description Grants access to load postings. Loads are publicly readable, but only the owner (shipper) can create, update, or delete them.
     * @path /loads/{loadId}
     * @allow (get) Any user can read a load.
     * @allow (list) Any user can list loads.
     * @allow (create) Shipper with ID 'shipper123' can create a load.
     * @allow (update) Shipper with ID 'shipper123' can update their load.
     * @allow (delete) Shipper with ID 'shipper123' can delete their load.
     * @deny (create) User with ID 'user456' cannot create a load for shipper 'shipper123'.
     * @principle Enforces owner-only writes for loads.
     */
    match /loads/{loadId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.shipperId == request.auth.uid;
      allow update: if isSignedIn() && resource != null && resource.data.shipperId == request.auth.uid;
      allow delete: if isSignedIn() && resource != null && resource.data.shipperId == request.auth.uid;
    }

    /**
     * @description Grants access to bids for each load.
     * @path /loads/{loadId}/bids/{bidId}
     * @allow (create) Carrier with ID 'carrier123' can create a bid for load 'load456'.
     * @allow (get) Any signed in user can get a bid for load 'load456'.
     * @allow (update) Carrier with ID 'carrier123' can update their bid for load 'load456'.
     * @allow (delete) Carrier with ID 'carrier123' can delete their bid for load 'load456'.
     * @deny (create) User with ID 'user456' cannot create a bid for carrier 'carrier123'.
     * @principle Enforces document ownership for writes.
     */
    match /loads/{loadId}/bids/{bidId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.carrierId == request.auth.uid && request.resource.data.loadId == loadId;
      allow update: if isSignedIn() && resource != null && resource.data.carrierId == request.auth.uid && request.resource.data.loadId == loadId;
      allow delete: if isSignedIn() && resource != null && resource.data.carrierId == request.auth.uid && request.resource.data.loadId == loadId;
    }

    /**
     * @description Grants access to emergency alerts for each truck.
     * @path /trucks/{truckId}/emergency_alerts/{alertId}
     * @allow (create) Any signed in user can create an emergency alert for truck 'truck123'.
     * @allow (get) Any signed in user can get an emergency alert for truck 'truck123'.
     * @allow (update) Any signed in user can update an emergency alert for truck 'truck123'.
     * @allow (delete) Any signed in user can delete an emergency alert for truck 'truck123'.
     * @deny (create) Anonymous user cannot create an emergency alert for truck 'truck123'.
     * @principle Only signed in users can access emergency alerts.
     */
    match /trucks/{truckId}/emergency_alerts/{alertId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.truckId == truckId;
      allow update: if isSignedIn() && resource != null && request.resource.data.truckId == truckId;
      allow delete: if isSignedIn() && resource != null && request.resource.data.truckId == truckId;
    }

        /**
     * @description Grants access to shipper profiles.
     * @path /shippers/{shipperId}
     * @allow (create) User with ID 'shipper123' can create their shipper profile.
     * @allow (get) User with ID 'shipper123' can read their shipper profile.
     * @allow (update) User with ID 'shipper123' can update their shipper profile.
     * @allow (delete) User with ID 'shipper123' can delete their shipper profile.
     * @deny (create) User with ID 'user456' cannot create a shipper profile with ID 'shipper123'.
     * @principle Enforces document ownership for writes.
     */
    match /shippers/{shipperId} {
      allow get: if isSignedIn() && isOwner(shipperId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(shipperId) && request.resource.data.id == shipperId;
      allow update: if isExistingOwner(shipperId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(shipperId);
    }

            /**
     * @description Grants access to carrier profiles.
     * @path /carriers/{carrierId}
     * @allow (create) User with ID 'carrier123' can create their carrier profile.
     * @allow (get) User with ID 'carrier123' can read their carrier profile.
     * @allow (update) User with ID 'carrier123' can update their carrier profile.
     * @allow (delete) User with ID 'carrier123' can delete their carrier profile.
     * @deny (create) User with ID 'user456' cannot create a carrier profile with ID 'carrier123'.
     * @principle Enforces document ownership for writes.
     */
    match /carriers/{carrierId} {
      allow get: if isSignedIn() && isOwner(carrierId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(carrierId) && request.resource.data.id == carrierId;
      allow update: if isExistingOwner(carrierId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(carrierId);
    }

                /**
     * @description Grants access to freight manager profiles.
     * @path /freight_managers/{freightManagerId}
     * @allow (create) User with ID 'freightManager123' can create their freight manager profile.
     * @allow (get) User with ID 'freightManager123' can read their freight manager profile.
     * @allow (update) User with ID 'freightManager123' can update their freight manager profile.
     * @allow (delete) User with ID 'freightManager123' can delete their freight manager profile.
     * @deny (create) User with ID 'user456' cannot create a freight manager profile with ID 'freightManager123'.
     * @principle Enforces document ownership for writes.
     */
    match /freight_managers/{freightManagerId} {
      allow get: if isSignedIn() && isOwner(freightManagerId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(freightManagerId) && request.resource.data.id == freightManagerId;
      allow update: if isExistingOwner(freightManagerId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(freightManagerId);
    }
  }
}