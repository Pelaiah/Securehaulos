/**
 * @file Firestore Security Rules for SecureHaul Application
 *
 * @core_philosophy This ruleset enforces a strict user-ownership model for personal data,
 * while allowing public read access to load postings. Write access is restricted to
 * authorized users based on their roles and relationships to the data.  The rules
 * avoid complex queries by denormalizing key authorization data (e.g., owner IDs)
 * directly onto the documents.  Schema validation is relaxed to allow rapid
 * prototyping, but ownership and relational integrity are strictly enforced.
 *
 * @data_structure
 * - `/users/{userId}`: Stores user profiles, accessible only to the user.
 * - `/users/{userId}/verification_documents/{documentId}`: Stores verification documents,
 *   accessible only to the user.
 * - `/users/{userId}/subscriptions/{subscriptionId}`: Stores subscription information,
 *   accessible only to the user.
 * - `/drivers/{driverId}`: Stores driver profiles, accessible only to the driver.
 * - `/drivers/{driverId}/trucks/{truckId}`: Stores trucks owned by the driver.
 * - `/loads/{loadId}`: Stores load postings, publicly readable but writable only by the shipper.
 * - `/loads/{loadId}/bids/{bidId}`: Stores bids for a load, writable only by the carrier.
 * - `/trucks/{truckId}/emergency_alerts/{alertId}`: Stores emergency alerts for a truck.
 * - `/shippers/{shipperId}`: Stores shipper profiles, accessible only to the shipper.
 * - `/carriers/{carrierId}`: Stores carrier profiles, accessible only to the carrier.
 * - `/freight_managers/{freightManagerId}`: Stores freight manager profiles, accessible only to the freight manager.
 *
 * @key_security_decisions
 * - User listing is disabled.
 * - Public read access is granted to the `/loads` collection.
 * - Data validation is limited to ownership and relational integrity checks for prototyping.
 * - All write operations require a verified user identity.
 * - Attempts to change the owner of a resource via an update are denied.
 *
 * @denormalization_for_authorization
 * - The `Load` document contains the `shipperId` to allow direct ownership checks.
 * - The `Bid` document contains both the `carrierId` and `loadId` for access control.
 *
 * @structural_segregation Data related to user profiles are stored in separate user subcollections.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows a user to read and write their own profile data.
     * @path /users/{userId}
     * @allow (create) User with ID 'user123' can create their profile.
     *   `request.auth.uid == 'user123' && request.resource.data.id == 'user123'`
     * @allow (get) User with ID 'user123' can read their profile.
     *   `request.auth.uid == 'user123'`
     * @allow (update) User with ID 'user123' can update their profile.
     *   `request.auth.uid == 'user123'`
     * @allow (delete) User with ID 'user123' can delete their profile.
     *   `request.auth.uid == 'user123'`
     * @deny (create) User with ID 'user123' cannot create a profile with ID 'user456'.
     *   `request.auth.uid == 'user123' && request.resource.data.id == 'user456'`
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      // Only signed-in users can access this collection
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false; // User listing is not allowed.
      allow create: if isSignedIn() && isNewOwner(userId);
      allow update: if isSignedIn() && isExistingOwner(userId) && isOwnerIdImmutable(userId);
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description Allows a user to manage their own verification documents.
     * @path /users/{userId}/verification_documents/{documentId}
     * @allow (create) User with ID 'user123' can create a verification document.
     *   `request.auth.uid == 'user123'`
     * @allow (get) User with ID 'user123' can read their verification document.
     *   `request.auth.uid == 'user123'`
     * @allow (update) User with ID 'user123' can update their verification document.
     *   `request.auth.uid == 'user123'`
     * @allow (delete) User with ID 'user123' can delete their verification document.
     *   `request.auth.uid == 'user123'`
     * @deny (create) User with ID 'user123' cannot create a verification document for 'user456'.
     *   `request.auth.uid == 'user123'`
     * @principle Enforces document ownership for writes. Restricts access to a user's own data tree.
     */
    match /users/{userId}/verification_documents/{documentId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isExistingOwner(userId);
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description Allows a user to manage their own subscription data.
     * @path /users/{userId}/subscriptions/{subscriptionId}
     * @allow (create) User with ID 'user123' can create a subscription.
     *   `request.auth.uid == 'user123'`
     * @allow (get) User with ID 'user123' can read their subscription.
     *   `request.auth.uid == 'user123'`
     * @allow (update) User with ID 'user123' can update their subscription.
     *   `request.auth.uid == 'user123'`
     * @allow (delete) User with ID 'user123' can delete their subscription.
     *   `request.auth.uid == 'user123'`
     * @deny (create) User with ID 'user123' cannot create a subscription for 'user456'.
     *   `request.auth.uid == 'user123'`
     * @principle Enforces document ownership for writes. Restricts access to a user's own data tree.
     */
    match /users/{userId}/subscriptions/{subscriptionId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isExistingOwner(userId);
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description Allows a driver to read and write their own driver profile.
     * @path /drivers/{driverId}
     * @allow (create) Driver with ID 'driver123' can create their profile.
     *   `request.auth.uid == 'driver123'`
     * @allow (get) Driver with ID 'driver123' can read their profile.
     *   `request.auth.uid == 'driver123'`
     * @allow (update) Driver with ID 'driver123' can update their profile.
     *   `request.auth.uid == 'driver123'`
     * @allow (delete) Driver with ID 'driver123' can delete their profile.
     *   `request.auth.uid == 'driver123'`
     * @deny (create) User with ID 'user123' cannot create a driver profile with ID 'driver456'.
     *   `request.auth.uid == 'user123'`
     * @principle Enforces document ownership for writes.
     */
    match /drivers/{driverId} {
      allow get: if isSignedIn() && isOwner(driverId);
      allow list: if false; // Driver listing is not allowed.
      allow create: if isSignedIn() && isNewOwner(driverId);
      allow update: if isSignedIn() && isExistingOwner(driverId) && isOwnerIdImmutable(driverId);
      allow delete: if isSignedIn() && isExistingOwner(driverId);
    }

    /**
     * @description Allows a driver to manage their own trucks.
     * @path /drivers/{driverId}/trucks/{truckId}
     * @allow (create) Driver with ID 'driver123' can create a truck.
     *   `request.auth.uid == 'driver123' && request.resource.data.driverId == 'driver123'`
     * @allow (get) Driver with ID 'driver123' can read their truck.
     *   `request.auth.uid == 'driver123'`
     * @allow (update) Driver with ID 'driver123' can update their truck.
     *   `request.auth.uid == 'driver123'`
     * @allow (delete) Driver with ID 'driver123' can delete their truck.
     *   `request.auth.uid == 'driver123'`
     * @deny (create) User with ID 'user123' cannot create a truck for 'driver456'.
     *   `request.auth.uid == 'user123'`
     * @principle Enforces document ownership for writes. Validates relational integrity.
     */
    match /drivers/{driverId}/trucks/{truckId} {
      allow get: if isSignedIn() && isDriverTruckOwner(driverId, truckId);
      allow list: if false;
      allow create: if isSignedIn() && request.resource.data.driverId == driverId;
      allow update: if isSignedIn() && isExistingDriverTruckOwner(driverId, truckId) && isTruckOwnerIdImmutable(driverId, truckId);
      allow delete: if isSignedIn() && isExistingDriverTruckOwner(driverId, truckId);
    }

    /**
     * @description Allows public read access to loads, but restricts write access to the shipper.
     * @path /loads/{loadId}
     * @allow (get) Any user can read a load.
     *   `true`
     * @allow (list) Any user can list loads.
     *   `true`
     * @allow (create) Shipper with ID 'shipper123' can create a load.
     *   `request.auth.uid == 'shipper123' && request.resource.data.shipperId == 'shipper123'`
     * @allow (update) Shipper with ID 'shipper123' can update their load.
     *   `request.auth.uid == 'shipper123' && resource.data.shipperId == 'shipper123'`
     * @allow (delete) Shipper with ID 'shipper123' can delete their load.
     *   `request.auth.uid == 'shipper123' && resource.data.shipperId == 'shipper123'`
     * @deny (create) User with ID 'user123' cannot create a load without being the shipper.
     *   `request.auth.uid == 'user123' && request.resource.data.shipperId != 'user123'`
     * @principle Allows public read with owner-only writes. Validates shipper ownership.
     */
    match /loads/{loadId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.shipperId == request.auth.uid;
      allow update: if isSignedIn() && isExistingLoadOwner(loadId);
      allow delete: if isSignedIn() && isExistingLoadOwner(loadId);
    }

    /**
     * @description Allows a carrier to bid on a load.
     * @path /loads/{loadId}/bids/{bidId}
     * @allow (create) Carrier with ID 'carrier123' can create a bid on load 'load456'.
     *   `request.auth.uid == 'carrier123' && request.resource.data.carrierId == 'carrier123' && request.resource.data.loadId == 'load456'`
     * @allow (get) Carrier with ID 'carrier123' can read their bid on load 'load456'.
     *   `request.auth.uid == 'carrier123' && resource.data.carrierId == 'carrier123' && resource.data.loadId == 'load456'`
     * @allow (update) Carrier with ID 'carrier123' can update their bid on load 'load456'.
     *   `request.auth.uid == 'carrier123' && resource.data.carrierId == 'carrier123' && resource.data.loadId == 'load456'`
     * @allow (delete) Carrier with ID 'carrier123' can delete their bid on load 'load456'.
     *   `request.auth.uid == 'carrier123' && resource.data.carrierId == 'carrier123' && resource.data.loadId == 'load456'`
     * @deny (create) User with ID 'user123' cannot create a bid without being the carrier.
     *   `request.auth.uid == 'user123' && request.resource.data.carrierId != 'user123'`
     * @principle Enforces document ownership for writes.  Validates relational integrity.
     */
    match /loads/{loadId}/bids/{bidId} {
      allow get: if isSignedIn() && isBidOwner(loadId, bidId);
      allow list: if false;
      allow create: if isSignedIn() && request.resource.data.carrierId == request.auth.uid && request.resource.data.loadId == loadId;
      allow update: if isSignedIn() && isExistingBidOwner(loadId, bidId);
      allow delete: if isSignedIn() && isExistingBidOwner(loadId, bidId);
    }

    /**
     * @description Allows management of emergency alerts for a truck.
     * @path /trucks/{truckId}/emergency_alerts/{alertId}
     * @allow (create) Any signed-in user can create an emergency alert.
     *   `request.auth != null`
     * @allow (get) Any signed-in user can read an emergency alert.
     *   `request.auth != null`
     * @allow (update) Any signed-in user can update an emergency alert.
     *   `request.auth != null`
     * @allow (delete) Any signed-in user can delete an emergency alert.
     *   `request.auth != null`
     * @deny (create) Non-signed-in user cannot create an emergency alert.
     *   `request.auth == null`
     * @principle Requires a verified user identity for all operations.
     */
    match /trucks/{truckId}/emergency_alerts/{alertId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Allows a shipper to read and write their own shipper profile.
     * @path /shippers/{shipperId}
     * @allow (create) Shipper with ID 'shipper123' can create their profile.
     *   `request.auth.uid == 'shipper123'`
     * @allow (get) Shipper with ID 'shipper123' can read their profile.
     *   `request.auth.uid == 'shipper123'`
     * @allow (update) Shipper with ID 'shipper123' can update their profile.
     *   `request.auth.uid == 'shipper123'`
     * @allow (delete) Shipper with ID 'shipper123' can delete their profile.
     *   `request.auth.uid == 'shipper123'`
     * @deny (create) User with ID 'user123' cannot create a shipper profile with ID 'shipper456'.
     *   `request.auth.uid == 'user123'`
     * @principle Enforces document ownership for writes.
     */
    match /shippers/{shipperId} {
      allow get: if isSignedIn() && isOwner(shipperId);
      allow list: if false; // Shipper listing is not allowed.
      allow create: if isSignedIn() && isNewOwner(shipperId);
      allow update: if isSignedIn() && isExistingOwner(shipperId) && isOwnerIdImmutable(shipperId);
      allow delete: if isSignedIn() && isExistingOwner(shipperId);
    }

    /**
     * @description Allows a carrier to read and write their own carrier profile.
     * @path /carriers/{carrierId}
     * @allow (create) Carrier with ID 'carrier123' can create their profile.
     *   `request.auth.uid == 'carrier123'`
     * @allow (get) Carrier with ID 'carrier123' can read their profile.
     *   `request.auth.uid == 'carrier123'`
     * @allow (update) Carrier with ID 'carrier123' can update their profile.
     *   `request.auth.uid == 'carrier123'`
     * @allow (delete) Carrier with ID 'carrier123' can delete their profile.
     *   `request.auth.uid == 'carrier123'`
     * @deny (create) User with ID 'user123' cannot create a carrier profile with ID 'carrier456'.
     *   `request.auth.uid == 'user123'`
     * @principle Enforces document ownership for writes.
     */
    match /carriers/{carrierId} {
      allow get: if isSignedIn() && isOwner(carrierId);
      allow list: if false; // Carrier listing is not allowed.
      allow create: if isSignedIn() && isNewOwner(carrierId);
      allow update: if isSignedIn() && isExistingOwner(carrierId) && isOwnerIdImmutable(carrierId);
      allow delete: if isSignedIn() && isExistingOwner(carrierId);
    }

    /**
     * @description Allows a freight manager to read and write their own freight manager profile.
     * @path /freight_managers/{freightManagerId}
     * @allow (create) Freight manager with ID 'freightManager123' can create their profile.
     *   `request.auth.uid == 'freightManager123'`
     * @allow (get) Freight manager with ID 'freightManager123' can read their profile.
     *   `request.auth.uid == 'freightManager123'`
     * @allow (update) Freight manager with ID 'freightManager123' can update their profile.
     *   `request.auth.uid == 'freightManager123'`
     * @allow (delete) Freight manager with ID 'freightManager123' can delete their profile.
     *   `request.auth.uid == 'freightManager123'`
     * @deny (create) User with ID 'user123' cannot create a freight manager profile with ID 'freightManager456'.
     *   `request.auth.uid == 'user123'`
     * @principle Enforces document ownership for writes.
     */
    match /freight_managers/{freightManagerId} {
      allow get: if isSignedIn() && isOwner(freightManagerId);
      allow list: if false; // Freight manager listing is not allowed.
      allow create: if isSignedIn() && isNewOwner(freightManagerId);
      allow update: if isSignedIn() && isExistingOwner(freightManagerId) && isOwnerIdImmutable(freightManagerId);
      allow delete: if isSignedIn() && isExistingOwner(freightManagerId);
    }

    // Generic helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Allow creation only if the document ID matches the user ID
    function isNewOwner(userId) {
        return request.auth.uid == userId && request.resource.data.id == userId;
    }

    function isExistingOwner(userId) {
        return isOwner(userId) && resource.data.id == userId;
    }

    // Prevents updates from changing the owner ID
    function isOwnerIdImmutable(ownerId) {
        return resource.data.id == ownerId;
    }
        
    // Truck ownership check
    function isDriverTruckOwner(driverId, truckId) {
        return resource.data.driverId == driverId;
    }
    
    function isExistingDriverTruckOwner(driverId, truckId) {
        return isDriverTruckOwner(driverId, truckId) && resource.data.driverId == driverId;
    }

    // Ensure truck ownership cannot be changed
    function isTruckOwnerIdImmutable(driverId, truckId) {
        return resource.data.driverId == driverId;
    }
    
    //Load ownership check
    function isLoadOwner(loadId) {
        return resource.data.shipperId == request.auth.uid;
    }
    
    // Check if Load exists before checking ownership
    function isExistingLoadOwner(loadId) {
        return resource.data.shipperId == request.auth.uid;
    }
    
    // Bid ownership check
    function isBidOwner(loadId, bidId) {
        return resource.data.carrierId == request.auth.uid && resource.data.loadId == loadId;
    }
    
    function isExistingBidOwner(loadId, bidId) {
        return resource.data.carrierId == request.auth.uid && resource.data.loadId == loadId;
    }

    //Handle batch write operations for assigning load updates.
    match /{document=**} {
      allow write: if false;
    }
  }
}