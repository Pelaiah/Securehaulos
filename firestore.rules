/**
 * @file Firestore Security Rules for SecureHaul Application
 *
 * @core_philosophy This ruleset enforces a strict user-ownership model for personal data,
 * while allowing public read access to certain collections like 'loads'.
 * Authorization independence is achieved by denormalizing key identifiers
 * (e.g., shipperId in Load documents) to avoid costly and complex 'get()' calls.
 *
 * @data_structure
 * - /users/{userId}: Stores user profiles; owned by the user.
 * - /users/{userId}/verification_documents/{documentId}: Verification documents for a specific user; owned by the user.
 * - /users/{userId}/subscriptions/{subscriptionId}: Subscription information for a user; owned by the user.
 * - /drivers/{driverId}: Stores driver profiles; owned by the driver.
 * - /drivers/{driverId}/trucks/{truckId}: Stores truck information for each driver; owned by the driver.
 * - /loads/{loadId}: Stores load postings; publicly readable, but owned by the shipper who created them.
 * - /loads/{loadId}/bids/{bidId}: Stores bids for each load; access controlled through load and carrier ownership.
 * - /trucks/{truckId}/emergency_alerts/{alertId}: Stores emergency alerts for each truck.
 * - /shippers/{shipperId}: Stores shipper profiles; owned by the shipper.
 * - /carriers/{carrierId}: Stores carrier profiles; owned by the carrier.
 * - /freight_managers/{freightManagerId}: Stores freight manager profiles; owned by the freight manager.
 *
 * @key_security_decisions
 * - User listing is implicitly disallowed by the absence of a top-level /users collection read rule.
 * - Public read access is granted to the /loads collection, but writes are restricted to the owner.
 * - Data consistency between document IDs and path parameters is enforced on create and update operations.
 *
 * @denormalization_for_authorization
 * - Loads: The `shipperId` is denormalized into the `Load` document to authorize updates and deletes without extra reads.
 * - Bids: The `carrierId` and `loadId` are denormalized into the `Bid` document to authorize access without extra reads.
 *
 * @structural_segregation Public read data is placed in the top-level `/loads` collection, while
 * private user data is stored under `/users/{userId}`.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is authenticated.
     * @path N/A
     * @allow N/A
     * @deny N/A
     * @principle Authentication is required for protected resources.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user's ID matches the provided user ID.
     * @path N/A
     * @allow N/A
     * @deny N/A
     * @principle Enforces user-based ownership.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user is the existing owner of the document.
     * @path N/A
     * @allow N/A
     * @deny N/A
     * @principle Combines ownership and existence check for safer operations.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Collection to store user profiles.
     * @path /users/{userId}
     * @allow (create) - User with ID 'user123' creates their own profile.
     * @deny (create) - User with ID 'user123' tries to create profile for 'user456'.
     * @principle Enforces user-based ownership for profile creation and modification.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Subcollection to store verification documents for each user.
     * @path /users/{userId}/verification_documents/{documentId}
     * @allow (create) - User 'user123' creates a verification document.
     * @deny (create) - User 'user123' tries to create a document for 'user456'.
     * @principle Path-based ownership ensures only the user can manage their documents.
     */
    match /users/{userId}/verification_documents/{documentId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Subcollection to store subscription information for each user.
     * @path /users/{userId}/subscriptions/{subscriptionId}
     * @allow (create) - User 'user123' creates a subscription.
     * @deny (create) - User 'user123' tries to create a subscription for 'user456'.
     * @principle Path-based ownership ensures only the user can manage their subscriptions.
     */
    match /users/{userId}/subscriptions/{subscriptionId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Collection to store driver-specific information.
     * @path /drivers/{driverId}
     * @allow (create) - User 'driver123' creates their own profile.
     * @deny (create) - User 'driver123' tries to create a profile for 'driver456'.
     * @principle Enforces user-based ownership for driver profile creation and modification.
     */
    match /drivers/{driverId} {
      allow get: if isOwner(driverId);
      allow list: if false;
      allow create: if isOwner(driverId) && request.resource.data.id == driverId;
      allow update: if isExistingOwner(driverId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(driverId);
    }

    /**
     * @description Subcollection to store truck information associated with each driver.
     * @path /drivers/{driverId}/trucks/{truckId}
     * @allow (create) - Driver 'driver123' creates a truck.
     * @deny (create) - Driver 'driver123' tries to create a truck for 'driver456'.
     * @principle Path-based ownership and document `driverId` field ensures trucks are owned by the correct drivers.
     */
    match /drivers/{driverId}/trucks/{truckId} {
      allow get: if isOwner(driverId);
      allow list: if isOwner(driverId);
      allow create: if isOwner(driverId) && request.resource.data.driverId == driverId;
      allow update: if isExistingOwner(driverId) && request.resource.data.driverId == resource.data.driverId;
      allow delete: if isExistingOwner(driverId);
    }

    /**
     * @description Collection to store load postings. Publicly readable, but writes are owner-only.
     * @path /loads/{loadId}
     * @allow (get, list) - Any user can read load postings.
     * @allow (create) - User 'shipper123' can create a load with shipperId 'shipper123'.
     * @deny (create) - User 'shipper123' tries to create a load with shipperId 'shipper456'.
     * @deny (update, delete) - User 'carrier456' tries to update/delete a load owned by 'shipper123'.
     * @principle Public read, owner-only write access for loads.
     */
    match /loads/{loadId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.shipperId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.shipperId == request.auth.uid && resource != null;
      allow delete: if isSignedIn() && resource.data.shipperId == request.auth.uid && resource != null;
    }

    /**
     * @description Subcollection to store bids for each load.
     * @path /loads/{loadId}/bids/{bidId}
     * @allow (create) - Carrier 'carrier123' can create a bid for load 'load456'.
     * @deny (create) - Carrier 'carrier123' tries to create a bid for a load they don't have access to.
     * @principle Bids are owned by the carrier and associated with a specific load.
     */
    match /loads/{loadId}/bids/{bidId} {
      allow get: if isSignedIn() && request.auth.uid == resource.data.carrierId;
      allow list: if isSignedIn() && get(/databases/$(database)/documents/loads/$(loadId)).data.shipperId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.carrierId == request.auth.uid && request.resource.data.loadId == loadId;
      allow update: if isSignedIn() && request.auth.uid == resource.data.carrierId && resource.data.loadId == loadId && resource != null;
      allow delete: if isSignedIn() && request.auth.uid == resource.data.carrierId && resource.data.loadId == loadId && resource != null;
    }

    /**
     * @description Subcollection to store emergency alerts for each truck.
     * @path /trucks/{truckId}/emergency_alerts/{alertId}
     * @allow (create) - Any authenticated user can create an alert for a truck.
     * @deny (create) - Non-authenticated user tries to create an alert.
     * @principle Emergency alerts can be created by any authenticated user for a truck.
     */
    match /trucks/{truckId}/emergency_alerts/{alertId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Collection to store shipper-specific information.
     * @path /shippers/{shipperId}
     * @allow (create) - User 'shipper123' creates their own profile.
     * @deny (create) - User 'shipper123' tries to create a profile for 'shipper456'.
     * @principle Enforces user-based ownership for shipper profile creation and modification.
     */
    match /shippers/{shipperId} {
      allow get: if isOwner(shipperId);
      allow list: if false;
      allow create: if isOwner(shipperId) && request.resource.data.id == shipperId;
      allow update: if isExistingOwner(shipperId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(shipperId);
    }

    /**
     * @description Collection to store carrier-specific information.
     * @path /carriers/{carrierId}
     * @allow (create) - User 'carrier123' creates their own profile.
     * @deny (create) - User 'carrier123' tries to create a profile for 'carrier456'.
     * @principle Enforces user-based ownership for carrier profile creation and modification.
     */
    match /carriers/{carrierId} {
      allow get: if isOwner(carrierId);
      allow list: if false;
      allow create: if isOwner(carrierId) && request.resource.data.id == carrierId;
      allow update: if isExistingOwner(carrierId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(carrierId);
    }

    /**
     * @description Collection to store freight manager-specific information.
     * @path /freight_managers/{freightManagerId}
     * @allow (create) - User 'freightManager123' creates their own profile.
     * @deny (create) - User 'freightManager123' tries to create a profile for 'freightManager456'.
     * @principle Enforces user-based ownership for freight manager profile creation and modification.
     */
    match /freight_managers/{freightManagerId} {
      allow get: if isOwner(freightManagerId);
      allow list: if false;
      allow create: if isOwner(freightManagerId) && request.resource.data.id == freightManagerId;
      allow update: if isExistingOwner(freightManagerId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(freightManagerId);
    }
  }
}