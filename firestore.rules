/**
 * @fileoverview Firestore Security Rules for SecureHaul application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for personal data and
 * a public-read, owner-write model for shared resources like loads and bids.
 * Data denormalization is used extensively to ensure authorization independence
 * and prevent costly or impossible security checks using `get()` calls.
 *
 * Data Structure:
 * - User profiles and related data (verification documents, subscriptions) are
 *   nested under `/users/{userId}`.
 * - Driver profiles and trucks are nested under `/drivers/{driverId}`.
 * - Loads are stored in the top-level `/loads/{loadId}` collection, with
 *   the `shipperId` field denormalized for efficient owner-based access control.
 * - Bids are stored in the `/loads/{loadId}/bids/{bidId}` subcollection,
 *   with the `carrierId` field denormalized for efficient carrier-based access control.
 * - Shipper, Carrier, and FreightManager profiles are in top-level collections.
 * - EmergencyAlerts are nested under `/trucks/{truckId}/emergency_alerts/{alertId}`.
 *
 * Key Security Decisions:
 * - Users can only read and write their own profile data and related subcollections.
 * - Loads are publicly readable but only the owner (shipper) can modify them.
 * - Bids are only writable by the carrier, and readable by the load owner (shipper).
 * - Listing of user subcollections is allowed only for the owner.
 * - Structural segregation is used, with private data stored in user subcollections.
 *
 * Denormalization for Authorization:
 * - Loads: The `shipperId` is stored directly in the `/loads/{loadId}` document,
 *   allowing for owner-based write rules without additional `get()` calls.
 * - Bids: The `carrierId` and `loadId` is stored directly in the `/loads/{loadId}/bids/{bidId}` document,
 *   allowing for carrier-based write rules without additional `get()` calls.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user's UID matches the provided userId.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user's UID matches the existing resource's ownerId.
     */
    function isExistingOwner(ownerId) {
        return (isOwner(ownerId) && resource != null);
    }

    /**
     * @description Rules for user profiles.
     * @path /users/{userId}
     * @allow (create) - Authenticated user creates their own profile.
     * @allow (get, update, delete) - Authenticated user accesses their own profile.
     * @deny (create) - Unauthenticated user attempts to create a profile.
     * @deny (get, update, delete) - Authenticated user attempts to access another user's profile.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; //Prevent listing all users.
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for verification documents.
     * @path /users/{userId}/verification_documents/{documentId}
     * @allow (create) - Authenticated user creates a verification document for their profile.
     * @allow (get, list, update, delete) - Authenticated user accesses their own verification documents.
     * @deny (create) - Unauthenticated user attempts to create a verification document.
     * @deny (get, list, update, delete) - Authenticated user attempts to access another user's verification documents.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/verification_documents/{documentId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for subscriptions.
     * @path /users/{userId}/subscriptions/{subscriptionId}
     * @allow (create) - Authenticated user creates a subscription for their profile.
     * @allow (get, list, update, delete) - Authenticated user accesses their own subscriptions.
     * @deny (create) - Unauthenticated user attempts to create a subscription.
     * @deny (get, list, update, delete) - Authenticated user attempts to access another user's subscriptions.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/subscriptions/{subscriptionId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for driver profiles.
     * @path /drivers/{driverId}
     * @allow (create) - Authenticated user creates their own driver profile.
     * @allow (get, update, delete) - Authenticated user accesses their own driver profile.
     * @deny (create) - Unauthenticated user attempts to create a driver profile.
     * @deny (get, update, delete) - Authenticated user attempts to access another user's driver profile.
     * @principle Enforces document ownership for all operations.
     */
    match /drivers/{driverId} {
      allow get: if isOwner(driverId);
      allow list: if false; //Prevent listing all drivers.
      allow create: if isOwner(driverId);
      allow update: if isExistingOwner(driverId);
      allow delete: if isExistingOwner(driverId);
    }

    /**
     * @description Rules for trucks associated with a driver.
     * @path /drivers/{driverId}/trucks/{truckId}
     * @allow (create) - Authenticated driver creates a truck associated with their profile.
     * @allow (get, list, update, delete) - Authenticated driver accesses their own truck information.
     * @deny (create) - Unauthenticated user attempts to create a truck for another driver.
     * @deny (get, list, update, delete) - Authenticated user attempts to access another driver's truck information.
     * @principle Enforces document ownership for all operations.
     */
    match /drivers/{driverId}/trucks/{truckId} {
      allow get: if isOwner(driverId);
      allow list: if isOwner(driverId);
      allow create: if isOwner(driverId) && request.resource.data.driverId == driverId;
      allow update: if isExistingOwner(driverId) && request.resource.data.driverId == resource.data.driverId;
      allow delete: if isExistingOwner(driverId);
    }

    /**
     * @description Rules for loads.
     * @path /loads/{loadId}
     * @allow (get, list) - Public read access for all loads.
     * @allow (create) - Authenticated user can create a load, with `shipperId` matching their UID.
     * @allow (update, delete) - Only the shipper who created the load can update or delete it.
     * @deny (create) - Authenticated user attempts to create a load with `shipperId` not matching their UID.
     * @deny (update, delete) - Authenticated user attempts to update or delete a load they don't own.
     * @principle Public read, owner-only write access for load postings.
     */
    match /loads/{loadId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.shipperId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.shipperId);
      allow delete: if isExistingOwner(resource.data.shipperId);
    }

    /**
     * @description Rules for bids associated with a load.
     * @path /loads/{loadId}/bids/{bidId}
     * @allow (create) - Authenticated carrier can create a bid for a load with `carrierId` matching their UID.
     * @allow (get, list) - Only the shipper of the load can get and list bids.
     * @allow (update, delete) - Only the carrier who created the bid can update or delete it.
     * @deny (create) - Authenticated user attempts to create a bid with `carrierId` not matching their UID.
     * @deny (get, list) - Authenticated user attempts to get or list bids for a load they don't own.
     * @deny (update, delete) - Authenticated user attempts to update or delete a bid they don't own.
     * @principle Owner-only write access for bids, shipper-only read access.
     */
    match /loads/{loadId}/bids/{bidId} {
      allow get: if get(/databases/$(database)/documents/loads/$(loadId)).data.shipperId == request.auth.uid;
      allow list: if get(/databases/$(database)/documents/loads/$(loadId)).data.shipperId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.carrierId == request.auth.uid;
      allow update: if isExistingOwner(request.resource.data.carrierId);
      allow delete: if isExistingOwner(request.resource.data.carrierId);
    }

    /**
     * @description Rules for emergency alerts associated with a truck.
     * @path /trucks/{truckId}/emergency_alerts/{alertId}
     *  // TODO: Determine and implement appropriate access control for emergency alerts.  Who should be able to create, read, update, and delete these alerts?
     */
    match /trucks/{truckId}/emergency_alerts/{alertId} {
      allow get: if true; // TODO: Add owner validation once the authorization is defined.
      allow list: if true; // TODO: Add owner validation once the authorization is defined.
      allow create: if true; // TODO: Add owner validation once the authorization is defined.
      allow update: if false; // TODO: Add owner validation once the authorization is defined.
      allow delete: if false; // TODO: Add owner validation once the authorization is defined.
    }

    /**
     * @description Rules for shipper profiles.
     * @path /shippers/{shipperId}
     * @allow (create) - Authenticated user creates their own shipper profile.
     * @allow (get, update, delete) - Authenticated user accesses their own shipper profile.
     * @deny (create) - Unauthenticated user attempts to create a shipper profile.
     * @deny (get, update, delete) - Authenticated user attempts to access another user's shipper profile.
     * @principle Enforces document ownership for all operations.
     */
    match /shippers/{shipperId} {
      allow get: if isOwner(shipperId);
      allow list: if false; //Prevent listing all shippers.
      allow create: if isOwner(shipperId);
      allow update: if isExistingOwner(shipperId);
      allow delete: if isExistingOwner(shipperId);
    }

    /**
     * @description Rules for carrier profiles.
     * @path /carriers/{carrierId}
     * @allow (create) - Authenticated user creates their own carrier profile.
     * @allow (get, update, delete) - Authenticated user accesses their own carrier profile.
     * @deny (create) - Unauthenticated user attempts to create a carrier profile.
     * @deny (get, update, delete) - Authenticated user attempts to access another user's carrier profile.
     * @principle Enforces document ownership for all operations.
     */
    match /carriers/{carrierId} {
      allow get: if isOwner(carrierId);
      allow list: if false; //Prevent listing all carriers.
      allow create: if isOwner(carrierId);
      allow update: if isExistingOwner(carrierId);
      allow delete: if isExistingOwner(carrierId);
    }

    /**
     * @description Rules for freight manager profiles.
     * @path /freight_managers/{freightManagerId}
     * @allow (create) - Authenticated user creates their own freight manager profile.
     * @allow (get, update, delete) - Authenticated user accesses their own freight manager profile.
     * @deny (create) - Unauthenticated user attempts to create a freight manager profile.
     * @deny (get, update, delete) - Authenticated user attempts to access another user's freight manager profile.
     * @principle Enforces document ownership for all operations.
     */
    match /freight_managers/{freightManagerId} {
      allow get: if isOwner(freightManagerId);
      allow list: if false; //Prevent listing all freight managers.
      allow create: if isOwner(freightManagerId);
      allow update: if isExistingOwner(freightManagerId);
      allow delete: if isExistingOwner(freightManagerId);
    }
  }
}