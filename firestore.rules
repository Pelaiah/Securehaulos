/**
 * @fileoverview Firestore Security Rules for SecureHaul application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user-related data
 * and a combination of ownership and shared access for other collections.
 *
 * Data Structure:
 * - User-specific data (verification documents, subscriptions) is nested under
 *   /users/{userId}.
 * - Loads, Bids, Trucks, EmergencyAlerts, Shippers, Carriers, and FreightManagers are stored in root-level collections.
 *
 * Key Security Decisions:
 * - Users can only access their own verification documents and subscriptions.
 * - Load ownership is determined by the `shipperId` field within the Load document.
 * - Bid ownership is determined by the `carrierId` field within the Bid document.
 * - Truck ownership is determined by the `driverId` and Truck documents are nested under the corresponding driver.
 * - No user listing is allowed (to prevent data scraping).
 *
 * Denormalization for Authorization:
 * - Loads: `shipperId` is stored directly in the Load document to avoid needing a `get()` on the Shipper document.
 * - Bids: `carrierId` and `loadId` are stored directly in the Bid document to avoid needing `get()` calls.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user is the owner of the resource.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user is the owner of an existing resource.
     * Used for update and delete operations to prevent acting on non-existent documents.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Rules for user profiles.
     * @path /users/{userId}
     * @allow (create) Authenticated user can create their own profile.
     * @deny (create) Authenticated user cannot create a profile for another user.
     * @allow (get) Authenticated user can get their own profile.
     * @deny (get) Authenticated user cannot get another user's profile.
     * @allow (update) Authenticated user can update their own profile.
     * @deny (update) Authenticated user cannot update another user's profile.
     * @allow (delete) Authenticated user can delete their own profile.
     * @deny (delete) Authenticated user cannot delete another user's profile.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow get: if isOwner(userId);
      allow list: if false;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for verification documents.
     * @path /users/{userId}/verification_documents/{documentId}
     * @allow (create) Authenticated user can create their own verification document.
     * @deny (create) Authenticated user cannot create a verification document for another user.
     * @allow (get) Authenticated user can get their own verification document.
     * @deny (get) Authenticated user cannot get another user's verification document.
     * @allow (update) Authenticated user can update their own verification document.
     * @deny (update) Authenticated user cannot update another user's verification document.
     * @allow (delete) Authenticated user can delete their own verification document.
     * @deny (delete) Authenticated user cannot delete another user's verification document.
     * @principle Restricts access to a user's own data tree.
     */
    match /users/{userId}/verification_documents/{documentId} {
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for subscriptions.
     * @path /users/{userId}/subscriptions/{subscriptionId}
     * @allow (create) Authenticated user can create their own subscription.
     * @deny (create) Authenticated user cannot create a subscription for another user.
     * @allow (get) Authenticated user can get their own subscription.
     * @deny (get) Authenticated user cannot get another user's subscription.
     * @allow (update) Authenticated user can update their own subscription.
     * @deny (update) Authenticated user cannot update another user's subscription.
     * @allow (delete) Authenticated user can delete their own subscription.
     * @deny (delete) Authenticated user cannot delete another user's subscription.
     * @principle Restricts access to a user's own data tree.
     */
    match /users/{userId}/subscriptions/{subscriptionId} {
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for drivers.
     * @path /drivers/{driverId}
     * @allow (create) Authenticated user can create their own driver profile.
     * @deny (create) Authenticated user cannot create a driver profile for another user.
     * @allow (get) Authenticated user can get their own driver profile.
     * @deny (get) Authenticated user cannot get another user's driver profile.
     * @allow (update) Authenticated user can update their own driver profile.
     * @deny (update) Authenticated user cannot update another user's driver profile.
     * @allow (delete) Authenticated user can delete their own driver profile.
     * @deny (delete) Authenticated user cannot delete another user's driver profile.
     * @principle Enforces document ownership for writes.
     */
    match /drivers/{driverId} {
      allow create: if isOwner(driverId) && request.resource.data.id == driverId;
      allow get: if true; // Allowing public read for prototyping. Consider restricting later.
      allow list: if false; // Explicitly disallowing listing.
      allow update: if isExistingOwner(driverId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(driverId);
    }

    /**
     * @description Rules for trucks associated with drivers.
     * @path /drivers/{driverId}/trucks/{truckId}
     * @allow (create) Authenticated driver can create a truck associated with their profile.
     * @deny (create) Authenticated driver cannot create a truck associated with another driver's profile.
     * @allow (get) Authenticated driver can get a truck associated with their profile.
     * @deny (get) Authenticated driver cannot get a truck associated with another driver's profile.
     * @allow (update) Authenticated driver can update a truck associated with their profile.
     * @deny (update) Authenticated driver cannot update a truck associated with another driver's profile.
     * @allow (delete) Authenticated driver can delete a truck associated with their profile.
     * @deny (delete) Authenticated driver cannot delete a truck associated with another driver's profile.
     * @principle Restricts access to a driver's own trucks.
     */
    match /drivers/{driverId}/trucks/{truckId} {
      allow create: if isOwner(driverId) && request.resource.data.driverId == driverId;
      allow get: if isOwner(driverId);
      allow list: if isOwner(driverId);
      allow update: if isExistingOwner(driverId) && request.resource.data.driverId == resource.data.driverId;
      allow delete: if isExistingOwner(driverId);
    }

    /**
     * @description Rules for loads.
     * @path /loads/{loadId}
     * @allow (create) Authenticated user can create a load if the shipperId matches their user ID.
     * @deny (create) Authenticated user cannot create a load if the shipperId does not match their user ID.
     * @allow (get) Anyone can get a load.
     * @deny (update) Only the owner (shipper) can update a load.
     * @deny (delete) Only the owner (shipper) can delete a load.
     * @principle Enforces ownership via the shipperId field.
     */
    match /loads/{loadId} {
      allow create: if isSignedIn() && request.resource.data.shipperId == request.auth.uid;
      allow get: if true;
      allow list: if true;
      allow update: if isSignedIn() && resource.data.shipperId == request.auth.uid && resource != null;
      allow delete: if isSignedIn() && resource.data.shipperId == request.auth.uid && resource != null;
    }

    /**
     * @description Rules for bids.
     * @path /loads/{loadId}/bids/{bidId}
     * @allow (create) Authenticated user can create a bid if the carrierId matches their user ID.
     * @deny (create) Authenticated user cannot create a bid if the carrierId does not match their user ID.
     * @allow (get) Anyone can get a bid.
     * @deny (update) Only the owner (carrier) can update a bid.
     * @deny (delete) Only the owner (carrier) can delete a bid.
     * @principle Enforces ownership via the carrierId field.
     */
    match /loads/{loadId}/bids/{bidId} {
      allow create: if isSignedIn() && request.resource.data.carrierId == request.auth.uid && request.resource.data.loadId == loadId;
      allow get: if true;
      allow list: if true;
      allow update: if isSignedIn() && resource.data.carrierId == request.auth.uid && resource != null;
      allow delete: if isSignedIn() && resource.data.carrierId == request.auth.uid && resource != null;
    }

    /**
     * @description Rules for emergency alerts.
     * @path /trucks/{truckId}/emergency_alerts/{alertId}
     * @principle No ownership check.
     */
    match /trucks/{truckId}/emergency_alerts/{alertId} {
      allow create: if true;
      allow get: if true;
      allow list: if true;
      allow update: if false;
      allow delete: if false;
    }

     /**
      * @description Rules for shippers.
      * @path /shippers/{shipperId}
      */
     match /shippers/{shipperId} {
        allow create: if isOwner(shipperId) && request.resource.data.id == shipperId;
        allow get: if true; // Allowing public read for prototyping. Consider restricting later.
        allow list: if false; // Explicitly disallowing listing.
        allow update: if isExistingOwner(shipperId) && request.resource.data.id == resource.data.id;
        allow delete: if isExistingOwner(shipperId);
     }

    /**
     * @description Rules for carriers.
     * @path /carriers/{carrierId}
     */
    match /carriers/{carrierId} {
        allow create: if isOwner(carrierId) && request.resource.data.id == carrierId;
        allow get: if true; // Allowing public read for prototyping. Consider restricting later.
        allow list: if false; // Explicitly disallowing listing.
        allow update: if isExistingOwner(carrierId) && request.resource.data.id == resource.data.id;
        allow delete: if isExistingOwner(carrierId);
    }

    /**
     * @description Rules for freight managers.
     * @path /freight_managers/{freightManagerId}
     */
    match /freight_managers/{freightManagerId} {
        allow create: if isOwner(freightManagerId) && request.resource.data.id == freightManagerId;
        allow get: if true; // Allowing public read for prototyping. Consider restricting later.
        allow list: if false; // Explicitly disallowing listing.
        allow update: if isExistingOwner(freightManagerId) && request.resource.data.id == resource.data.id;
        allow delete: if isExistingOwner(freightManagerId);
    }
  }
}