/**
 * @fileOverview Firestore Security Rules for SecureHaul application.
 *
 * Core Philosophy:
 * This ruleset enforces a user-ownership model for user-related data and allows public read access with owner-only writes for load postings.
 * It prioritizes authorization independence by denormalizing access control data within documents.
 *
 * Data Structure:
 * - User profiles are stored under `/users/{userId}`.
 * - Verification documents and subscriptions are nested under `/users/{userId}`.
 * - Load postings are stored in the top-level `/loads/{loadId}` collection and include a `shipperId` field.
 * - Bids are nested under `/loads/{loadId}/bids/{bidId}` and include `carrierId` and `loadId`.
 * - Driver and carrier profiles are stored in the top-level `/drivers/{driverId}` and `/carriers/{carrierId}` collections respectively.
 * - Trucks owned by a driver are nested under `/drivers/{driverId}/trucks/{truckId}`.
 *
 * Key Security Decisions:
 * - Users can only manage their own profiles and related data (verification documents, subscriptions).
 * - Load postings are publicly readable, but only the owner (shipper) can modify or delete them.
 * - Prevents listing of all users.
 * - Bids can only be created, updated, or deleted by the carrier that created them.
 *
 * Denormalization for Authorization:
 * - `/loads/{loadId}` documents include a `shipperId` field to enable owner-only writes.
 * - `/loads/{loadId}/bids/{bidId}` documents include a `carrierId` field to enable owner-only writes.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is made by a signed-in user.
     * @returns {boolean} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user's ID matches the provided user ID.
     * @param {string} userId - The user ID to compare against.
     * @returns {boolean} True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

     /**
      * @description Checks if the authenticated user's ID matches the provided user ID and the document exists.
      * @param {string} userId - The user ID to compare against.
      * @returns {boolean} True if the user is the owner and the resource exists, false otherwise.
      */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Rules for the /users/{userId} collection.
     * @path /users/{userId}
     * @allow (create) - A user can create their own profile if the userId matches their auth UID.
     * @allow (get, update, delete) - A user can read, update, and delete their own profile if the userId matches their auth UID.
     * @deny (create) - A user cannot create a profile with a userId that doesn't match their auth UID.
     * @deny (update, delete) - A user cannot update or delete another user's profile.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for the /users/{userId}/verification_documents/{documentId} collection.
     * @path /users/{userId}/verification_documents/{documentId}
     * @allow (create, get, list, update, delete) - A user can manage their own verification documents.
     * @deny (create, get, list, update, delete) - A user cannot manage another user's verification documents.
     * @principle Restricts access to a user's own verification documents.
     */
    match /users/{userId}/verification_documents/{documentId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for the /users/{userId}/subscriptions/{subscriptionId} collection.
     * @path /users/{userId}/subscriptions/{subscriptionId}
     * @allow (create, get, list, update, delete) - A user can manage their own subscriptions.
     * @deny (create, get, list, update, delete) - A user cannot manage another user's subscriptions.
     * @principle Restricts access to a user's own subscriptions.
     */
    match /users/{userId}/subscriptions/{subscriptionId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

     /**
      * @description Rules for the /drivers/{driverId} collection.
      * @path /drivers/{driverId}
      * @allow (get) - Any signed in user can get a driver profile.
      * @allow (create, update, delete) - Only the driver themselves can create, update, or delete their profile.
      * @deny (create) - A user cannot create a profile with a driverId that doesn't match their auth UID.
      * @deny (update, delete) - A user cannot update or delete another driver's profile.
      *  @principle Enforces document ownership for writes.
      */
    match /drivers/{driverId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isOwner(driverId) && request.resource.data.id == driverId;
      allow update: if isExistingOwner(driverId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(driverId);
    }

    /**
     * @description Rules for the /drivers/{driverId}/trucks/{truckId} collection.
     * @path /drivers/{driverId}/trucks/{truckId}
     * @allow (create, get, list, update, delete) - A driver can manage their own trucks.
     * @deny (create, get, list, update, delete) - A user cannot manage another driver's trucks.
     * @principle Restricts access to a driver's own trucks.
     */
    match /drivers/{driverId}/trucks/{truckId} {
      allow get: if isOwner(driverId);
      allow list: if isOwner(driverId);
      allow create: if isOwner(driverId) && request.resource.data.driverId == driverId;
      allow update: if isExistingOwner(driverId) && request.resource.data.driverId == resource.data.driverId;
      allow delete: if isExistingOwner(driverId);
    }

    /**
     * @description Rules for the /loads/{loadId} collection.
     * @path /loads/{loadId}
     * @allow (get, list) - Anyone can read load postings.
     * @allow (create) - A signed-in user can create a load posting, if the shipperId matches their auth UID.
     * @allow (update, delete) - Only the shipper who created the load can update or delete it.
     * @deny (create) - A user cannot create a load with a shipperId that doesn't match their auth UID.
     * @deny (update, delete) - A user cannot update or delete a load they don't own.
     * @principle Allows public read access with owner-only writes.
     */
    match /loads/{loadId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.shipperId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.shipperId == request.auth.uid && resource != null;
      allow delete: if isSignedIn() && resource.data.shipperId == request.auth.uid && resource != null;
    }

    /**
     * @description Rules for the /loads/{loadId}/bids/{bidId} collection.
     * @path /loads/{loadId}/bids/{bidId}
     * @allow (create) - A carrier can create a bid for a load if the carrierId matches their auth UID.
     * @allow (get, list, update, delete) - Only the carrier who created the bid can manage it.
     * @deny (create) - A user cannot create a bid with a carrierId that doesn't match their auth UID.
     * @deny (update, delete) - A user cannot update or delete a bid they don't own.
     * @principle Restricts bid management to the creating carrier.
     */
    match /loads/{loadId}/bids/{bidId} {
      allow get: if isSignedIn() && resource.data.carrierId == request.auth.uid;
      allow list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.carrierId == request.auth.uid && request.resource.data.loadId == loadId;
      allow update: if isSignedIn() && resource.data.carrierId == request.auth.uid && resource != null;
      allow delete: if isSignedIn() && resource.data.carrierId == request.auth.uid && resource != null;
    }

    /**
     * @description Rules for the /trucks/{truckId}/emergency_alerts/{alertId} collection.
     * @path /trucks/{truckId}/emergency_alerts/{alertId}
     * // TODO: Add owner validation once the schema is updated with an ownership field.
     */
    match /trucks/{truckId}/emergency_alerts/{alertId} {
      allow get: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
      allow list: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
      allow create: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
      allow update: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
      allow delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

     /**
      * @description Rules for the /shippers/{shipperId} collection.
      * @path /shippers/{shipperId}
      * @allow (get) - Any signed in user can get a shipper profile.
      * @allow (create, update, delete) - Only the shipper themselves can create, update, or delete their profile.
      * @deny (create) - A user cannot create a profile with a shipperId that doesn't match their auth UID.
      * @deny (update, delete) - A user cannot update or delete another shipper's profile.
      * @principle Enforces document ownership for writes.
      */
    match /shippers/{shipperId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isOwner(shipperId) && request.resource.data.id == shipperId;
      allow update: if isExistingOwner(shipperId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(shipperId);
    }

    /**
     * @description Rules for the /carriers/{carrierId} collection.
     * @path /carriers/{carrierId}
     * @allow (get) - Any signed in user can get a carrier profile.
     * @allow (create, update, delete) - Only the carrier themselves can create, update, or delete their profile.
     * @deny (create) - A user cannot create a profile with a carrierId that doesn't match their auth UID.
     * @deny (update, delete) - A user cannot update or delete another carrier's profile.
     * @principle Enforces document ownership for writes.
     */
    match /carriers/{carrierId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isOwner(carrierId) && request.resource.data.id == carrierId;
      allow update: if isExistingOwner(carrierId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(carrierId);
    }

    /**
     * @description Rules for the /freight_managers/{freightManagerId} collection.
     * @path /freight_managers/{freightManagerId}
     * @allow (get) - Any signed in user can get a freight manager profile.
     * @allow (create, update, delete) - Only the freight manager themselves can create, update, or delete their profile.
     * @deny (create) - A user cannot create a profile with a freightManagerId that doesn't match their auth UID.
     * @deny (update, delete) - A user cannot update or delete another freight manager's profile.
     * @principle Enforces document ownership for writes.
     */
    match /freight_managers/{freightManagerId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isOwner(freightManagerId) && request.resource.data.id == freightManagerId;
      allow update: if isExistingOwner(freightManagerId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(freightManagerId);
    }
  }
}