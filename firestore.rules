/**
 * @fileoverview Firestore Security Rules for SecureHaul application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user-related data
 * and a combination of ownership and public-read with owner-write for loads.
 * All write operations are protected by authorization checks to ensure data integrity.
 *
 * Data Structure:
 * - Users: /users/{userId} - Stores basic user profile information.
 * - Verification Documents: /users/{userId}/verification_documents/{documentId} -
 *   Stores user verification documents, accessible only by the user.
 * - Subscriptions: /users/{userId}/subscriptions/{subscriptionId} - Stores
 *   subscription details for each user, accessible only by the user.
 * - Drivers: /drivers/{driverId} - Stores driver-specific information.
 * - Trucks: /drivers/{driverId}/trucks/{truckId} - Stores truck information
 *   associated with each driver, accessible only by the driver. Includes the `driverId`.
 * - Loads: /loads/{loadId} - Stores load postings, accessible for reading by
 *   everyone, but only created/updated/deleted by the owner (shipper). Contains the `shipperId`.
 * - Bids: /loads/{loadId}/bids/{bidId} - Stores bids for loads, accessible by the carrier making the bid. Contains the `loadId` and `carrierId`.
 * - Emergency Alerts: /trucks/{truckId}/emergency_alerts/{alertId} - Stores emergency alerts for trucks.
 * - Shippers: /shippers/{shipperId} - Stores shipper information.
 * - Carriers: /carriers/{carrierId} - Stores carrier information.
 * - Freight Managers: /freight_managers/{freightManagerId} - Stores freight manager information.
 *
 * Key Security Decisions:
 * - Users can only access their own data under the /users/{userId} collection
 *   and its subcollections.
 * - Loads are publicly readable, but only the owner (shipper) can modify them.
 * - Listing of users is not allowed.
 *
 * Denormalization for Authorization:
 * - The `loads` documents contain `shipperId`, eliminating the need for additional
 *   reads to verify ownership.
 * - The `bids` documents contain `carrierId` and `loadId`, eliminating the need for additional reads to verify carrier and load associations.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is made by an authenticated user.
     * @path N/A
     * @allow N/A
     * @deny N/A
     * @principle Verifies user authentication.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the request is made by the owner of the resource.
     * @path N/A
     * @allow N/A
     * @deny N/A
     * @principle Enforces ownership-based access control.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the request is made by the owner of the resource and the resource exists.
     * @path N/A
     * @allow N/A
     * @deny N/A
     * @principle Enforces existence check combined with ownership-based access control for updates and deletes.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Rules for the /users/{userId} collection.
     * @path /users/{userId}
     * @allow (create) - Authenticated user creates their own user document with matching userId.
     * @deny (create) - Unauthenticated user attempts to create a user document.
     * @allow (get, update, delete) - Authenticated user can access their own user document.
     * @deny (get, update, delete) - Authenticated user attempts to access another user's document.
     * @principle Enforces user-ownership for user profiles.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Prevent listing of all users.
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for the /users/{userId}/verification_documents/{documentId} subcollection.
     * @path /users/{userId}/verification_documents/{documentId}
     * @allow (create) - Authenticated user creates a verification document under their user ID.
     * @deny (create) - Authenticated user attempts to create a verification document under another user's ID.
     * @allow (get, update, delete) - Authenticated user can access their own verification documents.
     * @deny (get, update, delete) - Authenticated user attempts to access another user's verification documents.
     * @principle Enforces user-ownership for verification documents.
     */
    match /users/{userId}/verification_documents/{documentId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for the /users/{userId}/subscriptions/{subscriptionId} subcollection.
     * @path /users/{userId}/subscriptions/{subscriptionId}
     * @allow (create) - Authenticated user creates a subscription under their user ID.
     * @deny (create) - Authenticated user attempts to create a subscription under another user's ID.
     * @allow (get, update, delete) - Authenticated user can access their own subscription.
     * @deny (get, update, delete) - Authenticated user attempts to access another user's subscription.
     * @principle Enforces user-ownership for subscriptions.
     */
    match /users/{userId}/subscriptions/{subscriptionId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for the /drivers/{driverId} collection.
     * @path /drivers/{driverId}
     * @allow (create) - Authenticated user creates their own driver profile document with matching driverId.
     * @deny (create) - Unauthenticated user attempts to create a driver profile document.
     * @allow (get, update, delete) - Authenticated user can access their own driver profile document.
     * @deny (get, update, delete) - Authenticated user attempts to access another user's driver profile document.
     * @principle Enforces user-ownership for driver profiles.
     */
    match /drivers/{driverId} {
      allow get: if isOwner(driverId);
      allow list: if false; // Prevent listing of all drivers.
      allow create: if isOwner(driverId);
      allow update: if isExistingOwner(driverId);
      allow delete: if isExistingOwner(driverId);
    }

    /**
     * @description Rules for the /drivers/{driverId}/trucks/{truckId} subcollection.
     * @path /drivers/{driverId}/trucks/{truckId}
     * @allow (create) - Authenticated user creates a truck under their driver ID.
     * @deny (create) - Authenticated user attempts to create a truck under another user's ID.
     * @allow (get, update, delete) - Authenticated user can access their own trucks.
     * @deny (get, update, delete) - Authenticated user attempts to access another user's trucks.
     * @principle Enforces user-ownership for trucks.
     */
    match /drivers/{driverId}/trucks/{truckId} {
      allow get: if isOwner(driverId);
      allow list: if isOwner(driverId);
      allow create: if isOwner(driverId);
      allow update: if isExistingOwner(driverId);
      allow delete: if isExistingOwner(driverId);
    }

    /**
     * @description Rules for the /loads/{loadId} collection.
     * @path /loads/{loadId}
     * @allow (get, list) - Anyone can read load postings.
     * @allow (create) - Authenticated user creates a load, shipperId matches request.auth.uid.
     * @deny (create) - Authenticated user creates a load, but shipperId does not match request.auth.uid.
     * @allow (update, delete) - Only the owner (identified by shipperId) can update or delete the load.
     * @deny (update, delete) - Non-owner attempts to update or delete the load.
     * @principle Allows public read access but enforces ownership for write access to loads.
     */
    match /loads/{loadId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.shipperId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.shipperId == request.auth.uid && resource != null;
      allow delete: if isSignedIn() && resource.data.shipperId == request.auth.uid && resource != null;
    }

    /**
     * @description Rules for the /loads/{loadId}/bids/{bidId} subcollection.
     * @path /loads/{loadId}/bids/{bidId}
     * @allow (create) - Authenticated carrier creates a bid, carrierId matches request.auth.uid.
     * @deny (create) - Authenticated user creates a bid, but carrierId does not match request.auth.uid.
     * @allow (get, update, delete) - Only the carrier (identified by carrierId) can access their bid.
     * @deny (get, update, delete) - Non-carrier attempts to access the bid.
     * @principle Enforces user-ownership for bids.
     */
    match /loads/{loadId}/bids/{bidId} {
      allow get: if isSignedIn() && resource.data.carrierId == request.auth.uid;
      allow list: if false; // Listing bids is not permitted.
      allow create: if isSignedIn() && request.resource.data.carrierId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.carrierId == request.auth.uid && resource != null;
      allow delete: if isSignedIn() && resource.data.carrierId == request.auth.uid && resource != null;
    }

    /**
     * @description Rules for the /trucks/{truckId}/emergency_alerts/{alertId} subcollection.
     * @path /trucks/{truckId}/emergency_alerts/{alertId}
     * @allow (create) - Authenticated user creates an emergency alert for a truck.
     * @deny (create) - Unauthenticated user attempts to create an emergency alert.
     * @allow (get, update, delete) - Only the owner (driver) of the truck can access alerts.
     * @deny (get, update, delete) - Non-owner attempts to access the alert.
     * @principle Enforces ownership for emergency alerts.
     */
    match /trucks/{truckId}/emergency_alerts/{alertId} {
      allow get: if false; // Emergency Alerts are only write-only.
      allow list: if false; // Emergency Alerts are only write-only.
      allow create: if isSignedIn(); // Only signed in users can create alerts
      allow update: if false;
      allow delete: if false;
    }

     /**
      * @description Rules for the /shippers/{shipperId} collection.
      * @path /shippers/{shipperId}
      * @allow (create) - Authenticated user creates their own shipper profile document with matching shipperId.
      * @deny (create) - Unauthenticated user attempts to create a shipper profile document.
      * @allow (get, update, delete) - Authenticated user can access their own shipper profile document.
      * @deny (get, update, delete) - Authenticated user attempts to access another user's shipper profile document.
      * @principle Enforces user-ownership for shipper profiles.
      */
    match /shippers/{shipperId} {
      allow get: if isOwner(shipperId);
      allow list: if false; // Prevent listing of all shippers.
      allow create: if isOwner(shipperId);
      allow update: if isExistingOwner(shipperId);
      allow delete: if isExistingOwner(shipperId);
    }

     /**
      * @description Rules for the /carriers/{carrierId} collection.
      * @path /carriers/{carrierId}
      * @allow (create) - Authenticated user creates their own carrier profile document with matching carrierId.
      * @deny (create) - Unauthenticated user attempts to create a carrier profile document.
      * @allow (get, update, delete) - Authenticated user can access their own carrier profile document.
      * @deny (get, update, delete) - Authenticated user attempts to access another user's carrier profile document.
      * @principle Enforces user-ownership for carrier profiles.
      */
    match /carriers/{carrierId} {
      allow get: if isOwner(carrierId);
      allow list: if false; // Prevent listing of all carriers.
      allow create: if isOwner(carrierId);
      allow update: if isExistingOwner(carrierId);
      allow delete: if isExistingOwner(carrierId);
    }

     /**
      * @description Rules for the /freight_managers/{freightManagerId} collection.
      * @path /freight_managers/{freightManagerId}
      * @allow (create) - Authenticated user creates their own freight manager profile document with matching freightManagerId.
      * @deny (create) - Unauthenticated user attempts to create a freight manager profile document.
      * @allow (get, update, delete) - Authenticated user can access their own freight manager profile document.
      * @deny (get, update, delete) - Authenticated user attempts to access another user's freight manager profile document.
      * @principle Enforces user-ownership for freight manager profiles.
      */
    match /freight_managers/{freightManagerId} {
      allow get: if isOwner(freightManagerId);
      allow list: if false; // Prevent listing of all freight managers.
      allow create: if isOwner(freightManagerId);
      allow update: if isExistingOwner(freightManagerId);
      allow delete: if isExistingOwner(freightManagerId);
    }
  }
}