/**
 * @fileoverview Firestore Security Rules for SecureHaul application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict ownership model for user-related data and
 * leverages denormalization to ensure authorization independence and prevent
 * rules-as-filters behavior. It prioritizes security by explicitly defining
 * access control for each data path and permission type.
 *
 * Data Structure:
 * - User profiles and related data (verification documents, subscriptions) are
 *   nested under /users/{userId}.
 * - Load postings are stored in the top-level /loads/{loadId} collection,
 *   containing the shipperId for owner-based authorization.
 *
 * Key Security Decisions:
 * - Listing of all users is disallowed.
 * - Read access to loads is public, but write access is restricted to the owner (shipper).
 * - Subcollections under /users/{userId} are strictly controlled by the owning user.
 *
 * Denormalization for Authorization:
 * - Loads include a denormalized 'shipperId' field to identify the owner.
 * - Bids include a denormalized 'carrierId' field to identify the owner and the 'loadId'.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user is the owner of the resource.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user is the existing owner of the resource.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Rule for the /users/{userId} collection.
     * @path /users/{userId}
     * @allow (create) User 'pjNkl1LQRje03gftpjh0EIEXmF03' can create their own user document.
     * @deny (create) User 'pjNkl1LQRje03gftpjh0EIEXmF03' cannot create a user document with a different ID.
     * @allow (get) User 'pjNkl1LQRje03gftpjh0EIEXmF03' can get their own user document.
     * @deny (get) User 'pjNkl1LQRje03gftpjh0EIEXmF03' cannot get another user's document.
     * @allow (update) User 'pjNkl1LQRje03gftpjh0EIEXmF03' can update their own user document.
     * @deny (update) User 'pjNkl1LQRje03gftpjh0EIEXmF03' cannot update another user's document.
     * @allow (delete) User 'pjNkl1LQRje03gftpjh0EIEXmF03' can delete their own user document.
     * @deny (delete) User 'pjNkl1LQRje03gftpjh0EIEXmF03' cannot delete another user's document.
     * @principle Enforces document ownership for all operations on user documents.
     */
    match /users/{userId} {
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.id == userId;
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rule for the /users/{userId}/verification_documents/{documentId} collection.
     * @path /users/{userId}/verification_documents/{documentId}
     * @allow (create) User 'pjNkl1LQRje03gftpjh0EIEXmF03' can create a verification document in their own subcollection.
     * @deny (create) User 'pjNkl1LQRje03gftpjh0EIEXmF03' cannot create a verification document in another user's subcollection.
     * @allow (get) User 'pjNkl1LQRje03gftpjh0EIEXmF03' can get a verification document from their own subcollection.
     * @deny (get) User 'pjNkl1LQRje03gftpjh0EIEXmF03' cannot get a verification document from another user's subcollection.
     * @allow (update) User 'pjNkl1LQRje03gftpjh0EIEXmF03' can update a verification document in their own subcollection.
     * @deny (update) User 'pjNkl1LQRje03gftpjh0EIEXmF03' cannot update a verification document in another user's subcollection.
     * @allow (delete) User 'pjNkl1LQRje03gftpjh0EIEXmF03' can delete a verification document from their own subcollection.
     * @deny (delete) User 'pjNkl1LQRje03gftpjh0EIEXmF03' cannot delete a verification document from another user's subcollection.
     * @principle Enforces document ownership for all operations on verification documents.
     */
    match /users/{userId}/verification_documents/{documentId} {
      allow create: if isSignedIn() && isOwner(userId);
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rule for the /users/{userId}/subscriptions/{subscriptionId} collection.
     * @path /users/{userId}/subscriptions/{subscriptionId}
     * @allow (create) User 'pjNkl1LQRje03gftpjh0EIEXmF03' can create a subscription in their own subcollection.
     * @deny (create) User 'pjNkl1LQRje03gftpjh0EIEXmF03' cannot create a subscription in another user's subcollection.
     * @allow (get) User 'pjNkl1LQRje03gftpjh0EIEXmF03' can get a subscription from their own subcollection.
     * @deny (get) User 'pjNkl1LQRje03gftpjh0EIEXmF03' cannot get a subscription from another user's subcollection.
     * @allow (update) User 'pjNkl1LQRje03gftpjh0EIEXmF03' can update a subscription in their own subcollection.
     * @deny (update) User 'pjNkl1LQRje03gftpjh0EIEXmF03' cannot update a subscription in another user's subcollection.
     * @allow (delete) User 'pjNkl1LQRje03gftpjh0EIEXmF03' can delete a subscription from their own subcollection.
     * @deny (delete) User 'pjNkl1LQRje03gftpjh0EIEXmF03' cannot delete a subscription from another user's subcollection.
     * @principle Enforces document ownership for all operations on subscription documents.
     */
    match /users/{userId}/subscriptions/{subscriptionId} {
      allow create: if isSignedIn() && isOwner(userId);
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rule for the /drivers/{driverId} collection.
     * @path /drivers/{driverId}
     * @allow (create) User 'pjNkl1LQRje03gftpjh0EIEXmF03' can create their own driver document.
     * @deny (create) User 'pjNkl1LQRje03gftpjh0EIEXmF03' cannot create a driver document with a different ID.
     * @allow (get) User 'pjNkl1LQRje03gftpjh0EIEXmF03' can get their own driver document.
     * @deny (get) User 'pjNkl1LQRje03gftpjh0EIEXmF03' cannot get another driver's document.
     * @allow (update) User 'pjNkl1LQRje03gftpjh0EIEXmF03' can update their own driver document.
     * @deny (update) User 'pjNkl1LQRje03gftpjh0EIEXmF03' cannot update another driver's document.
     * @allow (delete) User 'pjNkl1LQRje03gftpjh0EIEXmF03' can delete their own driver document.
     * @deny (delete) User 'pjNkl1LQRje03gftpjh0EIEXmF03' cannot delete another driver's document.
     * @principle Enforces document ownership for all operations on driver documents.
     */
    match /drivers/{driverId} {
      allow create: if isSignedIn() && isOwner(driverId) && request.resource.data.id == driverId;
      allow get: if isSignedIn() && isOwner(driverId);
      allow list: if false;
      allow update: if isExistingOwner(driverId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(driverId);
    }

    /**
     * @description Rule for the /drivers/{driverId}/trucks/{truckId} collection.
     * @path /drivers/{driverId}/trucks/{truckId}
     * @allow (create) User 'pjNkl1LQRje03gftpjh0EIEXmF03' can create a truck document in their own subcollection.
     * @deny (create) User 'pjNkl1LQRje03gftpjh0EIEXmF03' cannot create a truck document in another user's subcollection.
     * @allow (get) User 'pjNkl1LQRje03gftpjh0EIEXmF03' can get a truck document from their own subcollection.
     * @deny (get) User 'pjNkl1LQRje03gftpjh0EIEXmF03' cannot get a truck document from another user's subcollection.
     * @allow (update) User 'pjNkl1LQRje03gftpjh0EIEXmF03' can update a truck document in their own subcollection.
     * @deny (update) User 'pjNkl1LQRje03gftpjh0EIEXmF03' cannot update a truck document in another user's subcollection.
     * @allow (delete) User 'pjNkl1LQRje03gftpjh0EIEXmF03' can delete a truck document from their own subcollection.
     * @deny (delete) User 'pjNkl1LQRje03gftpjh0EIEXmF03' cannot delete a truck document from another user's subcollection.
     * @principle Enforces document ownership for all operations on truck documents.
     */
    match /drivers/{driverId}/trucks/{truckId} {
      allow create: if isSignedIn() && isOwner(driverId) && request.resource.data.driverId == driverId;
      allow get: if isSignedIn() && isOwner(driverId);
      allow list: if isSignedIn() && isOwner(driverId);
      allow update: if isExistingOwner(driverId) && request.resource.data.driverId == resource.data.driverId;
      allow delete: if isExistingOwner(driverId);
    }

    /**
     * @description Rule for the /loads/{loadId} collection.
     * @path /loads/{loadId}
     * @allow (create) User 'pjNkl1LQRje03gftpjh0EIEXmF03' can create a load if the shipperId matches their user ID.
     * @deny (create) User 'pjNkl1LQRje03gftpjh0EIEXmF03' cannot create a load if the shipperId does not match their user ID.
     * @allow (get) Any user can get a load.
     * @allow (list) Any user can list loads.
     * @allow (update) User 'pjNkl1LQRje03gftpjh0EIEXmF03' can update a load if they are the shipper.
     * @deny (update) User 'pjNkl1LQRje03gftpjh0EIEXmF03' cannot update a load if they are not the shipper.
     * @allow (delete) User 'pjNkl1LQRje03gftpjh0EIEXmF03' can delete a load if they are the shipper.
     * @deny (delete) User 'pjNkl1LQRje03gftpjh0EIEXmF03' cannot delete a load if they are not the shipper.
     * @principle Allows public read access but restricts writes to the load owner (shipper).
     */
    match /loads/{loadId} {
      allow create: if isSignedIn() && request.resource.data.shipperId == request.auth.uid;
      allow get: if true;
      allow list: if true;
      allow update: if isSignedIn() && resource.data.shipperId == request.auth.uid && resource != null;
      allow delete: if isSignedIn() && resource.data.shipperId == request.auth.uid && resource != null;
    }

    /**
     * @description Rule for the /loads/{loadId}/bids/{bidId} collection.
     * @path /loads/{loadId}/bids/{bidId}
     * @allow (create) User 'pjNkl1LQRje03gftpjh0EIEXmF03' can create a bid if the carrierId matches their user ID.
     * @deny (create) User 'pjNkl1LQRje03gftpjh0EIEXmF03' cannot create a bid if the carrierId does not match their user ID.
     * @allow (get) Any signed-in user can get a bid.
     * @deny (get) If is not signed-in cannot get a bid.
     * @allow (list) Any signed-in user can list bids.
     * @deny (list) If is not signed-in cannot list bids.
     * @allow (update) User 'pjNkl1LQRje03gftpjh0EIEXmF03' can update a bid if they are the carrier.
     * @deny (update) User 'pjNkl1LQRje03gftpjh0EIEXmF03' cannot update a bid if they are not the carrier.
     * @allow (delete) User 'pjNkl1LQRje03gftpjh0EIEXmF03' can delete a bid if they are the carrier.
     * @deny (delete) User 'pjNkl1LQRje03gftpjh0EIEXmF03' cannot delete a bid if they are not the carrier.
     * @principle Enforces that only the carrier who created the bid can modify or delete it.
     */
    match /loads/{loadId}/bids/{bidId} {
      allow create: if isSignedIn() && request.resource.data.carrierId == request.auth.uid && request.resource.data.loadId == loadId;
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow update: if isSignedIn() && resource.data.carrierId == request.auth.uid && resource != null;
      allow delete: if isSignedIn() && resource.data.carrierId == request.auth.uid && resource != null;
    }

    /**
     * @description Rule for the /trucks/{truckId}/emergency_alerts/{alertId} collection.
     * @path /trucks/{truckId}/emergency_alerts/{alertId}
     * @allow (create) Any signed-in user can create an emergency alert.
     * @deny (create) If is not signed-in cannot create a emergency alert.
     * @allow (get) Any signed-in user can get an emergency alert.
     * @deny (get) If is not signed-in cannot get a emergency alert.
     * @allow (list) Any signed-in user can list emergency alerts.
     * @deny (list) If is not signed-in cannot list emergency alerts.
     * @allow (update) No one can update an emergency alert.
     * @allow (delete) No one can delete an emergency alert.
     */
    match /trucks/{truckId}/emergency_alerts/{alertId} {
      allow create: if isSignedIn();
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Rule for the /shippers/{shipperId} collection.
     * @path /shippers/{shipperId}
     * @allow (create) User 'pjNkl1LQRje03gftpjh0EIEXmF03' can create their own shipper document.
     * @deny (create) User 'pjNkl1LQRje03gftpjh0EIEXmF03' cannot create a shipper document with a different ID.
     * @allow (get) User 'pjNkl1LQRje03gftpjh0EIEXmF03' can get their own shipper document.
     * @deny (get) User 'pjNkl1LQRje03gftpjh0EIEXmF03' cannot get another shipper's document.
     * @allow (update) User 'pjNkl1LQRje03gftpjh0EIEXmF03' can update their own shipper document.
     * @deny (update) User 'pjNkl1LQRje03gftpjh0EIEXmF03' cannot update another shipper's document.
     * @allow (delete) User 'pjNkl1LQRje03gftpjh0EIEXmF03' can delete their own shipper document.
     * @deny (delete) User 'pjNkl1LQRje03gftpjh0EIEXmF03' cannot delete another shipper's document.
     * @principle Enforces document ownership for all operations on shipper documents.
     */
    match /shippers/{shipperId} {
      allow create: if isSignedIn() && isOwner(shipperId) && request.resource.data.id == shipperId;
      allow get: if isSignedIn() && isOwner(shipperId);
      allow list: if false;
      allow update: if isExistingOwner(shipperId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(shipperId);
    }

    /**
     * @description Rule for the /carriers/{carrierId} collection.
     * @path /carriers/{carrierId}
     * @allow (create) User 'pjNkl1LQRje03gftpjh0EIEXmF03' can create their own carrier document.
     * @deny (create) User 'pjNkl1LQRje03gftpjh0EIEXmF03' cannot create a carrier document with a different ID.
     * @allow (get) User 'pjNkl1LQRje03gftpjh0EIEXmF03' can get their own carrier document.
     * @deny (get) User 'pjNkl1LQRje03gftpjh0EIEXmF03' cannot get another carrier's document.
     * @allow (update) User 'pjNkl1LQRje03gftpjh0EIEXmF03' can update their own carrier document.
     * @deny (update) User 'pjNkl1LQRje03gftpjh0EIEXmF03' cannot update another carrier's document.
     * @allow (delete) User 'pjNkl1LQRje03gftpjh0EIEXmF03' can delete their own carrier document.
     * @deny (delete) User 'pjNkl1LQRje03gftpjh0EIEXmF03' cannot delete another carrier's document.
     * @principle Enforces document ownership for all operations on carrier documents.
     */
    match /carriers/{carrierId} {
      allow create: if isSignedIn() && isOwner(carrierId) && request.resource.data.id == carrierId;
      allow get: if isSignedIn() && isOwner(carrierId);
      allow list: if false;
      allow update: if isExistingOwner(carrierId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(carrierId);
    }

    /**
     * @description Rule for the /freight_managers/{freightManagerId} collection.
     * @path /freight_managers/{freightManagerId}
     * @allow (create) User 'pjNkl1LQRje03gftpjh0EIEXmF03' can create their own freight manager document.
     * @deny (create) User 'pjNkl1LQRje03gftpjh0EIEXmF03' cannot create a freight manager document with a different ID.
     * @allow (get) User 'pjNkl1LQRje03gftpjh0EIEXmF03' can get their own freight manager document.
     * @deny (get) User 'pjNkl1LQRje03gftpjh0EIEXmF03' cannot get another freight manager's document.
     * @allow (update) User 'pjNkl1LQRje03gftpjh0EIEXmF03' can update their own freight manager document.
     * @deny (update) User 'pjNkl1LQRje03gftpjh0EIEXmF03' cannot update another freight manager's document.
     * @allow (delete) User 'pjNkl1LQRje03gftpjh0EIEXmF03' can delete their own freight manager document.
     * @deny (delete) User 'pjNkl1LQRje03gftpjh0EIEXmF03' cannot delete another freight manager's document.
     * @principle Enforces document ownership for all operations on freight manager documents.
     */
    match /freight_managers/{freightManagerId} {
      allow create: if isSignedIn() && isOwner(freightManagerId) && request.resource.data.id == freightManagerId;
      allow get: if isSignedIn() && isOwner(freightManagerId);
      allow list: if false;
      allow update: if isExistingOwner(freightManagerId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(freightManagerId);
    }
  }
}