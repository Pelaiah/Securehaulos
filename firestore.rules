rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows users to read and write their own user profiles.
     * @path /users/{userId}
     * @allow (create) User with ID 'user123' can create their profile.
     * @allow (get) User with ID 'user123' can read their profile.
     * @allow (update) User with ID 'user123' can update their profile.
     * @deny (create) User with ID 'user456' cannot create a profile with ID 'user123'.
     * @deny (get) User with ID 'user456' cannot read profile with ID 'user123'.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Allows users to manage their own verification documents.
     * @path /users/{userId}/verification_documents/{documentId}
     * @allow (create) User with ID 'user123' can create a verification document.
     * @allow (get) User with ID 'user123' can read a verification document.
     * @allow (update) User with ID 'user123' can update a verification document.
     * @deny (create) User with ID 'user456' cannot create a verification document for user 'user123'.
     * @deny (get) User with ID 'user456' cannot read verification document for user 'user123'.
     * @principle Enforces document ownership for writes, restricts access to a user's own data tree, and validates relational integrity between documents.
     */
    match /users/{userId}/verification_documents/{documentId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Allows users to manage their own subscription information.
     * @path /users/{userId}/subscriptions/{subscriptionId}
     * @allow (create) User with ID 'user123' can create a subscription.
     * @allow (get) User with ID 'user123' can read their subscription.
     * @allow (update) User with ID 'user123' can update their subscription.
     * @deny (create) User with ID 'user456' cannot create a subscription for user 'user123'.
     * @deny (get) User with ID 'user456' cannot read subscription for user 'user123'.
     * @principle Enforces document ownership for writes, restricts access to a user's own data tree, and validates relational integrity between documents.
     */
    match /users/{userId}/subscriptions/{subscriptionId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Allows drivers to read and write their own driver profiles.
     * @path /drivers/{driverId}
     * @allow (create) Driver with ID 'driver123' can create their profile.
     * @allow (get) Driver with ID 'driver123' can read their profile.
     * @allow (update) Driver with ID 'driver123' can update their profile.
     * @deny (create) User with ID 'user456' cannot create a profile with ID 'driver123'.
     * @deny (get) User with ID 'user456' cannot read profile with ID 'driver123'.
     * @principle Enforces document ownership for writes.
     */
    match /drivers/{driverId} {
      function isOwner(driverId) {
        return request.auth != null && request.auth.uid == driverId;
      }

      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isOwner(driverId);
      allow list: if false;
      allow create: if isSignedIn() && request.auth.uid == driverId;
      allow update: if isOwner(driverId);
      allow delete: if isOwner(driverId);
    }

    /**
     * @description Allows drivers to manage their own truck information.
     * @path /drivers/{driverId}/trucks/{truckId}
     * @allow (create) Driver with ID 'driver123' can create a truck.
     * @allow (get) Driver with ID 'driver123' can read truck 'truck123' if truck.driverId == 'driver123'.
     * @allow (update) Driver with ID 'driver123' can update truck 'truck123' if truck.driverId == 'driver123'.
     * @deny (create) User with ID 'user456' cannot create a truck for driver 'driver123'.
     * @deny (get) User with ID 'user456' cannot read truck 'truck123' for driver 'driver123'.
     * @principle Enforces document ownership for writes, restricts access to a user's own data tree, and validates relational integrity between documents.
     */
    match /drivers/{driverId}/trucks/{truckId} {
      function isOwner(driverId) {
        return request.auth != null && request.auth.uid == driverId;
      }

      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isOwner(driverId);
      allow list: if false;
      allow create: if isOwner(driverId);
      allow update: if isOwner(driverId);
      allow delete: if isOwner(driverId);
    }

    /**
     * @description Allows public read access to load postings, but restricts write access to the owner (shipper).
     * @path /loads/{loadId}
     * @allow (get) Any user can read a load posting.
     * @allow (list) Any user can list load postings.
     * @allow (create) User with ID 'user123' can create a load posting where request.resource.data.shipperId == 'user123'.
     * @allow (update) User with ID 'user123' can update a load posting where resource.data.shipperId == 'user123'.
     * @deny (create) User with ID 'user456' cannot create a load posting where request.resource.data.shipperId == 'user123'.
     * @deny (update) User with ID 'user456' cannot update a load posting where resource.data.shipperId == 'user123'.
     * @principle Allows public read with owner-only writes and validates relational integrity between documents.
     */
    match /loads/{loadId} {
      function isOwner(shipperId) {
        return request.auth != null && request.auth.uid == shipperId;
      }

      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.shipperId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.shipperId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.shipperId == request.auth.uid;
    }

    /**
     * @description Allows access to bids based on carrier ID.
     * @path /loads/{loadId}/bids/{bidId}
     * @allow (create) Carrier with ID 'carrier123' can create a bid for load 'load123' where request.resource.data.carrierId == 'carrier123' and request.resource.data.loadId == 'load123'.
     * @allow (get) Carrier with ID 'carrier123' can get a bid for load 'load123' where resource.data.carrierId == 'carrier123'
     * @allow (list) Carrier with ID 'carrier123' can list bids for load 'load123'.
     * @allow (update) Carrier with ID 'carrier123' can update a bid for load 'load123' where resource.data.carrierId == 'carrier123'.
     * @deny (create) Carrier with ID 'carrier456' cannot create a bid for load 'load123' with carrierId 'carrier123'.
     * @deny (get) Carrier with ID 'carrier456' cannot get a bid for load 'load123' with carrierId 'carrier123'.
     * @principle Enforces document ownership for writes and validates relational integrity between documents.
     */
    match /loads/{loadId}/bids/{bidId} {
      function isOwner(carrierId) {
        return request.auth != null && request.auth.uid == carrierId;
      }

      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isSignedIn() && resource.data.carrierId == request.auth.uid;
      allow list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.carrierId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.carrierId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.carrierId == request.auth.uid;
    }

    /**
     * @description Allows access to emergency alerts based on truck ID.
     * @path /trucks/{truckId}/emergency_alerts/{alertId}
     * @allow (create) Any authenticated user can create an emergency alert for a truck.
     * @allow (get) Any authenticated user can get an emergency alert for a truck.
     * @allow (list) Any authenticated user can list emergency alerts for a truck.
     * @allow (update) Any authenticated user can update an emergency alert for a truck.
     * @principle Requires a signed-in user for any operation.
     */
    match /trucks/{truckId}/emergency_alerts/{alertId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Allows shippers to read and write their own shipper profiles.
     * @path /shippers/{shipperId}
     * @allow (create) Shipper with ID 'shipper123' can create their profile.
     * @allow (get) Shipper with ID 'shipper123' can read their profile.
     * @allow (update) Shipper with ID 'shipper123' can update their profile.
     * @deny (create) User with ID 'user456' cannot create a profile with ID 'shipper123'.
     * @deny (get) User with ID 'user456' cannot read profile with ID 'shipper123'.
     * @principle Enforces document ownership for writes.
     */
    match /shippers/{shipperId} {
      function isOwner(shipperId) {
        return request.auth != null && request.auth.uid == shipperId;
      }

      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isOwner(shipperId);
      allow list: if false;
      allow create: if isSignedIn() && request.auth.uid == shipperId;
      allow update: if isOwner(shipperId);
      allow delete: if isOwner(shipperId);
    }

    /**
     * @description Allows carriers to read and write their own carrier profiles.
     * @path /carriers/{carrierId}
     * @allow (create) Carrier with ID 'carrier123' can create their profile.
     * @allow (get) Carrier with ID 'carrier123' can read their profile.
     * @allow (update) Carrier with ID 'carrier123' can update their profile.
     * @deny (create) User with ID 'user456' cannot create a profile with ID 'carrier123'.
     * @deny (get) User with ID 'user456' cannot read profile with ID 'carrier123'.
     * @principle Enforces document ownership for writes.
     */
    match /carriers/{carrierId} {
      function isOwner(carrierId) {
        return request.auth != null && request.auth.uid == carrierId;
      }

      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isOwner(carrierId);
      allow list: if false;
      allow create: if isSignedIn() && request.auth.uid == carrierId;
      allow update: if isOwner(carrierId);
      allow delete: if isOwner(carrierId);
    }

    /**
     * @description Allows freight managers to read and write their own freight manager profiles.
     * @path /freight_managers/{freightManagerId}
     * @allow (create) FreightManager with ID 'freightManager123' can create their profile.
     * @allow (get) FreightManager with ID 'freightManager123' can read their profile.
     * @allow (update) FreightManager with ID 'freightManager123' can update their profile.
     * @deny (create) User with ID 'user456' cannot create a profile with ID 'freightManager123'.
     * @deny (get) User with ID 'user456' cannot read profile with ID 'freightManager123'.
     * @principle Enforces document ownership for writes.
     */
    match /freight_managers/{freightManagerId} {
      function isOwner(freightManagerId) {
        return request.auth != null && request.auth.uid == freightManagerId;
      }

      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isOwner(freightManagerId);
      allow list: if false;
      allow create: if isSignedIn() && request.auth.uid == freightManagerId;
      allow update: if isOwner(freightManagerId);
      allow delete: if isOwner(freightManagerId);
    }
  }
}