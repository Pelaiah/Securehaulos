/**
 * @file Firebase Security Rules for SecureHaul application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for personal data (users, drivers).
 * Loads can be created by any authenticated user, but only the owner (shipper) can modify them.
 * Carriers are allowed to bid on loads.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles, secured by user ID.
 * - /users/{userId}/verification_documents/{documentId}: Stores verification documents, owned by the user.
 * - /users/{userId}/subscriptions/{subscriptionId}: Stores subscription information, owned by the user.
 * - /drivers/{driverId}: Stores driver profiles, secured by driver ID.
 * - /drivers/{driverId}/trucks/{truckId}: Stores truck information, owned by the driver. Truck document includes the `driverId`
 * - /loads/{loadId}: Stores load postings. Includes denormalized 'shipperId' for authorization independence.
 * - /loads/{loadId}/bids/{bidId}: Stores bids for each load. Includes denormalized 'carrierId' and `loadId` for authorization independence. The bid document includes the `loadId` and `carrierId`.
 * - /trucks/{truckId}/emergency_alerts/{alertId}: Stores emergency alerts for each truck.
 * - /shippers/{shipperId}: Stores shipper profiles, secured by shipper ID.
 * - /carriers/{carrierId}: Stores carrier profiles, secured by carrier ID.
 * - /freight_managers/{freightManagerId}: Stores freight manager profiles, secured by freight manager ID.
 *
 * Key Security Decisions:
 * - Users can only access their own data under /users/{userId}.
 * - Loads are readable by anyone but only the shipper can modify them.
 * - Bids can only be created by carriers for specific loads.
 * - Listing of user documents is not allowed.
 *
 * Denormalization for Authorization:
 * - Loads: Contains a `shipperId` field to avoid needing to read the associated Shipper document.
 * - Bids: Contains `carrierId` and `loadId` to avoid needing to read the associated Carrier and Load documents.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user is the owner of the document.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the user is the existing owner of the document (exists and is owner).
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Security rules for user profiles.
     * @path /users/{userId}
     * @allow (create) User with ID 'user123' can create their own profile.
     * @allow (get) User with ID 'user123' can read their own profile.
     * @deny (create) User with ID 'user456' cannot create a profile for 'user123'.
     * @deny (update) User with ID 'user456' cannot update the profile for 'user123'.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Security rules for verification documents.
     * @path /users/{userId}/verification_documents/{documentId}
     * @allow (create) User with ID 'user123' can create a verification document.
     * @allow (get) User with ID 'user123' can read their own verification document.
     * @deny (create) User with ID 'user456' cannot create a verification document for 'user123'.
     * @deny (update) User with ID 'user456' cannot update the verification document for 'user123'.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/verification_documents/{documentId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Security rules for subscriptions.
     * @path /users/{userId}/subscriptions/{subscriptionId}
     * @allow (create) User with ID 'user123' can create a subscription.
     * @allow (get) User with ID 'user123' can read their own subscription.
     * @deny (create) User with ID 'user456' cannot create a subscription for 'user123'.
     * @deny (update) User with ID 'user456' cannot update the subscription for 'user123'.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/subscriptions/{subscriptionId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Security rules for driver profiles.
     * @path /drivers/{driverId}
     * @allow (create) Driver with ID 'driver123' can create their own profile.
     * @allow (get) Driver with ID 'driver123' can read their own profile.
     * @deny (create) User with ID 'user456' cannot create a profile for 'driver123'.
     * @deny (update) User with ID 'user456' cannot update the profile for 'driver123'.
     * @principle Enforces document ownership for all operations.
     */
    match /drivers/{driverId} {
      allow get: if isOwner(driverId);
      allow list: if false;
      allow create: if isOwner(driverId) && request.resource.data.id == driverId;
      allow update: if isExistingOwner(driverId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(driverId);
    }

    /**
     * @description Security rules for truck information.
     * @path /drivers/{driverId}/trucks/{truckId}
     * @allow (create) Driver with ID 'driver123' can create a truck.
     * @allow (get) Driver with ID 'driver123' can read their own truck.
     * @deny (create) User with ID 'user456' cannot create a truck for 'driver123'.
     * @deny (update) User with ID 'user456' cannot update the truck for 'driver123'.
     * @principle Enforces document ownership for all operations.
     */
    match /drivers/{driverId}/trucks/{truckId} {
      allow get: if isOwner(driverId);
      allow list: if isOwner(driverId);
      allow create: if isOwner(driverId) && request.resource.data.driverId == driverId;
      allow update: if isExistingOwner(driverId) && request.resource.data.driverId == resource.data.driverId;
      allow delete: if isExistingOwner(driverId);
    }

    /**
     * @description Security rules for load postings.
     * @path /loads/{loadId}
     * @allow (create) Shipper can create a load if the shipperId matches their user ID.
     * @allow (get) Anyone can read a load.
     * @deny (update) User who is not the shipper cannot update the load.
     * @principle Allows public read access but restricts write access to the owner (shipper).
     */
    match /loads/{loadId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.shipperId == request.auth.uid;
      allow update: if isSignedIn() && resource != null && resource.data.shipperId == request.auth.uid;
      allow delete: if isSignedIn() && resource != null && resource.data.shipperId == request.auth.uid;
    }

    /**
     * @description Security rules for bids on loads.
     * @path /loads/{loadId}/bids/{bidId}
     * @allow (create) Carrier can create a bid for a load if the carrierId matches their user ID.
     * @allow (get) Anyone can read a bid.
     * @deny (update) User who is not the carrier cannot update the bid.
     * @principle Allows public read access but restricts write access to the owner (carrier).
     */
    match /loads/{loadId}/bids/{bidId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.carrierId == request.auth.uid && request.resource.data.loadId == loadId;
      allow update: if isExistingOwner(request.auth.uid) && request.resource.data.carrierId == resource.data.carrierId && request.resource.data.loadId == resource.data.loadId; //TODO: Remove isExistingOwner, no ownership.
      allow delete: if false; //Bids cannot be deleted
    }

    /**
     * @description Security rules for emergency alerts for trucks.
     * @path /trucks/{truckId}/emergency_alerts/{alertId}
     * @allow (create) Truck can create an emergency alert. Requires authentication.
     * @allow (get) Only the owner (driver) of the truck can read the emergency alert.
     * @deny (update) No one can update the emergency alert.
     * @principle Restricts access to emergency alerts based on truck ownership.
     */
    match /trucks/{truckId}/emergency_alerts/{alertId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Security rules for shipper profiles.
     * @path /shippers/{shipperId}
     * @allow (create) Shipper can create their own profile.
     * @allow (get) Shipper can read their own profile.
     * @deny (create) User with ID 'user456' cannot create a profile for 'shipper123'.
     * @deny (update) User with ID 'user456' cannot update the profile for 'shipper123'.
     * @principle Enforces document ownership for all operations.
     */
    match /shippers/{shipperId} {
      allow get: if isOwner(shipperId);
      allow list: if false;
      allow create: if isOwner(shipperId) && request.resource.data.id == shipperId;
      allow update: if isExistingOwner(shipperId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(shipperId);
    }

    /**
     * @description Security rules for carrier profiles.
     * @path /carriers/{carrierId}
     * @allow (create) Carrier can create their own profile.
     * @allow (get) Carrier can read their own profile.
     * @deny (create) User with ID 'user456' cannot create a profile for 'carrier123'.
     * @deny (update) User with ID 'user456' cannot update the profile for 'carrier123'.
     * @principle Enforces document ownership for all operations.
     */
    match /carriers/{carrierId} {
      allow get: if isOwner(carrierId);
      allow list: if false;
      allow create: if isOwner(carrierId) && request.resource.data.id == carrierId;
      allow update: if isExistingOwner(carrierId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(carrierId);
    }

    /**
     * @description Security rules for freight manager profiles.
     * @path /freight_managers/{freightManagerId}
     * @allow (create) Freight manager can create their own profile.
     * @allow (get) Freight manager can read their own profile.
     * @deny (create) User with ID 'user456' cannot create a profile for 'freightManager123'.
     * @deny (update) User with ID 'user456' cannot update the profile for 'freightManager123'.
     * @principle Enforces document ownership for all operations.
     */
    match /freight_managers/{freightManagerId} {
      allow get: if isOwner(freightManagerId);
      allow list: if false;
      allow create: if isOwner(freightManagerId) && request.resource.data.id == freightManagerId;
      allow update: if isExistingOwner(freightManagerId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(freightManagerId);
    }
  }
}