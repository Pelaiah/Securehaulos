/**
 * @file SecureHaul Firestore Security Rules
 * @version 2
 *
 * @Core Philosophy
 * This ruleset enforces a strict user-ownership model for personal data and a role-based model for shared resources like loads and bids. It leverages denormalization to avoid costly `get()` calls, improving performance and security.
 *
 * @Data Structure
 * - /users/{userId}: User profiles, accessible only to the user themselves.
 * - /users/{userId}/verification_documents/{documentId}: Verification documents owned by the user.
 * - /users/{userId}/subscriptions/{subscriptionId}: Subscription information owned by the user.
 * - /drivers/{driverId}: Driver profiles, accessible only to the driver themselves.
 * - /drivers/{driverId}/trucks/{truckId}: Trucks owned by the driver.
 * - /loads/{loadId}: Load postings, owned by the shipper.
 * - /loads/{loadId}/bids/{bidId}: Bids for loads, accessible to the carrier and the shipper of the load.
 * - /trucks/{truckId}/emergency_alerts/{alertId}: Emergency alerts for trucks, accessible to the truck's driver.
 * - /shippers/{shipperId}: Shipper profiles, accessible only to the shipper themselves.
 * - /carriers/{carrierId}: Carrier profiles, accessible only to the carrier themselves.
 * - /freight_managers/{freightManagerId}: Freight manager profiles, accessible only to the freight manager themselves.
 *
 * @Key Security Decisions
 * - Users can only access their own data under their /users/{userId} path.
 * - Load data is accessible to the shipper (owner) and the assigned carrier.
 * - Bids are accessible to the carrier who created the bid and the shipper who owns the load.
 * - Listing of user documents is disallowed for privacy.
 *
 * @Denormalization for Authorization
 * - Loads include the `shipperId` for owner-based access control.
 * - Bids include both the `carrierId` and `loadId` for access control.
 *
 * @Structural Segregation
 * Private user data (verification documents, subscriptions) is stored in user-specific subcollections to avoid accidental public exposure.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is made by an authenticated user.
     * @path N/A
     * @allow N/A
     * @deny N/A
     * @principle N/A
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the request is made by the owner of the document.
     * @path N/A
     * @allow N/A
     * @deny N/A
     * @principle N/A
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user is the owner of the existing document.
     * @path N/A
     * @allow N/A
     * @deny N/A
     * @principle N/A
     */
    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }

    /**
     * @description Allows the user to read their own profile.
     * @path /users/{userId}
     * @allow (get, list) User with ID 'user123' reads their own profile.
     * @deny (get, list) User with ID 'user123' tries to read the profile of user 'user456'.
     * @principle Enforces user-only access to profile data.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Allows a user to manage their own verification documents.
     * @path /users/{userId}/verification_documents/{documentId}
     * @allow (create, get, update, delete) User with ID 'user123' creates, reads, updates, or deletes their own verification document.
     * @deny (create, get, update, delete) User with ID 'user123' tries to manage verification documents of user 'user456'.
     * @principle Enforces user-only access to verification documents.
     */
    match /users/{userId}/verification_documents/{documentId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Allows a user to manage their own subscription information.
     * @path /users/{userId}/subscriptions/{subscriptionId}
     * @allow (create, get, update, delete) User with ID 'user123' creates, reads, updates, or deletes their own subscription.
     * @deny (create, get, update, delete) User with ID 'user123' tries to manage subscriptions of user 'user456'.
     * @principle Enforces user-only access to subscription data.
     */
    match /users/{userId}/subscriptions/{subscriptionId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Allows a driver to read and manage their own driver profile.
     * @path /drivers/{driverId}
     * @allow (get, list) Driver with ID 'driver123' reads their own profile.
     * @allow (create, update, delete) Driver with ID 'driver123' creates, updates, or deletes their own profile.
     * @deny (get, list) Driver with ID 'driver123' tries to read the profile of driver 'driver456'.
     * @deny (create, update, delete) Driver with ID 'driver123' tries to modify the profile of driver 'driver456'.
     * @principle Enforces user-only access to driver profiles.
     */
    match /drivers/{driverId} {
      allow get: if isOwner(driverId);
      allow list: if false;
      allow create: if isOwner(driverId) && request.resource.data.id == driverId;
      allow update: if isExistingOwner(driverId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(driverId);
    }

    /**
     * @description Allows a driver to manage their own trucks.
     * @path /drivers/{driverId}/trucks/{truckId}
     * @allow (create, get, update, delete) Driver with ID 'driver123' creates, reads, updates, or deletes their own truck.
     * @deny (create, get, update, delete) Driver with ID 'driver123' tries to manage trucks of driver 'driver456'.
     * @principle Enforces user-only access to truck data.
     */
    match /drivers/{driverId}/trucks/{truckId} {
      allow get: if isOwner(driverId);
      allow list: if isOwner(driverId);
      allow create: if isOwner(driverId) && request.resource.data.driverId == driverId;
      allow update: if isExistingOwner(driverId) && request.resource.data.driverId == resource.data.driverId;
      allow delete: if isExistingOwner(driverId);
    }

    /**
     * @description Allows anyone to read load postings, but only the shipper can create, update, or delete them.
     * @path /loads/{loadId}
     * @allow (get, list) Any user can read or list load postings.
     * @allow (create) Shipper with ID 'shipper123' creates a load posting.
     * @allow (update, delete) Shipper with ID 'shipper123' updates or deletes their own load posting.
     * @deny (create, update, delete) User with ID 'user123' tries to modify load postings of shipper 'shipper123'.
     * @principle Enforces owner-only writes for loads while allowing public reads.
     */
    match /loads/{loadId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.shipperId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.shipperId == request.auth.uid && resource != null;
      allow delete: if isSignedIn() && resource.data.shipperId == request.auth.uid && resource != null;
    }

    /**
     * @description Allows a carrier to create bids for loads, and allows the carrier and shipper to read their own bids.
     * @path /loads/{loadId}/bids/{bidId}
     * @allow (create) Carrier with ID 'carrier123' creates a bid for a load.
     * @allow (get) Carrier with ID 'carrier123' reads their own bid for load 'load123'.
     * @allow (get) Shipper with ID 'shipper456' reads bids for their load 'load123'.
     * @deny (update, delete) No one can update or delete bids.
     * @principle Allows carrier to bid, and shipper/carrier to read.  No updates or deletes.
     */
    match /loads/{loadId}/bids/{bidId} {
      allow get: if request.auth.uid == resource.data.carrierId || get(/databases/$(database)/documents/loads/$(loadId)).data.shipperId == request.auth.uid;
      allow list: if false;
      allow create: if isSignedIn() && request.resource.data.carrierId == request.auth.uid && request.resource.data.loadId == loadId;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows a truck's driver to manage emergency alerts for their trucks.
     * @path /trucks/{truckId}/emergency_alerts/{alertId}
     * @allow (create, get, update, delete) Driver with ID 'driver123' creates, reads, updates, or deletes emergency alerts for their truck.
     * @deny (create, get, update, delete) User with ID 'user123' tries to manage emergency alerts for trucks of driver 'driver123'.
     * @principle Enforces user-only access to emergency alerts.
     */
    match /trucks/{truckId}/emergency_alerts/{alertId} {
      allow get: if get(/databases/$(database)/documents/drivers/$(resource.data.truckId)).data.driverId == request.auth.uid;
      allow list: if false;
      allow create: if isSignedIn();  // TODO: Refine this rule to check for truck ownership.
      allow update: if false; // TODO: Add owner validation once truck ownership is clarified.
      allow delete: if false; // TODO: Add owner validation once truck ownership is clarified.
    }

    /**
     * @description Allows a shipper to manage their own shipper profile.
     * @path /shippers/{shipperId}
     * @allow (get, list) Shipper with ID 'shipper123' reads their own profile.
     * @allow (create, update, delete) Shipper with ID 'shipper123' creates, updates, or deletes their own profile.
     * @deny (get, list) Shipper with ID 'shipper123' tries to read the profile of shipper 'shipper456'.
     * @deny (create, update, delete) Shipper with ID 'shipper123' tries to modify the profile of shipper 'shipper456'.
     * @principle Enforces user-only access to shipper profiles.
     */
    match /shippers/{shipperId} {
      allow get: if isOwner(shipperId);
      allow list: if false;
      allow create: if isOwner(shipperId) && request.resource.data.id == shipperId;
      allow update: if isExistingOwner(shipperId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(shipperId);
    }

    /**
     * @description Allows a carrier to manage their own carrier profile.
     * @path /carriers/{carrierId}
     * @allow (get, list) Carrier with ID 'carrier123' reads their own profile.
     * @allow (create, update, delete) Carrier with ID 'carrier123' creates, updates, or deletes their own profile.
     * @deny (get, list) Carrier with ID 'carrier123' tries to read the profile of carrier 'carrier456'.
     * @deny (create, update, delete) Carrier with ID 'carrier123' tries to modify the profile of carrier 'carrier456'.
     * @principle Enforces user-only access to carrier profiles.
     */
    match /carriers/{carrierId} {
      allow get: if isOwner(carrierId);
      allow list: if false;
      allow create: if isOwner(carrierId) && request.resource.data.id == carrierId;
      allow update: if isExistingOwner(carrierId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(carrierId);
    }

    /**
     * @description Allows a freight manager to manage their own freight manager profile.
     * @path /freight_managers/{freightManagerId}
     * @allow (get, list) Freight manager with ID 'freightManager123' reads their own profile.
     * @allow (create, update, delete) Freight manager with ID 'freightManager123' creates, updates, or deletes their own profile.
     * @deny (get, list) Freight manager with ID 'freightManager123' tries to read the profile of freight manager 'freightManager456'.
     * @deny (create, update, delete) Freight manager with ID 'freightManager123' tries to modify the profile of freight manager 'freightManager456'.
     * @principle Enforces user-only access to freight manager profiles.
     */
    match /freight_managers/{freightManagerId} {
      allow get: if isOwner(freightManagerId);
      allow list: if false;
      allow create: if isOwner(freightManagerId) && request.resource.data.id == freightManagerId;
      allow update: if isExistingOwner(freightManagerId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(freightManagerId);
    }
  }
}