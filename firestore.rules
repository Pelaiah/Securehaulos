/**
 * @fileoverview Firestore Security Rules for SecureHaul application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for personal data and
 * a public-read with owner-write model for shared resources like loads.
 * Access is granted based on verified identity and path-based ownership.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles, with subcollections for private data.
 * - /drivers/{driverId}: Stores driver profiles.
 * - /drivers/{driverId}/trucks/{truckId}: Stores truck data owned by drivers.
 * - /loads/{loadId}: Stores load postings.
 * - /loads/{loadId}/bids/{bidId}: Stores bids for each load.
 * - /shippers/{shipperId}: Stores shipper profiles.
 * - /carriers/{carrierId}: Stores carrier profiles.
 * - /freight_managers/{freightManagerId}: Stores freight manager profiles.
 *
 * Key Security Decisions:
 * - Users can only read/write their own profile and associated subcollections.
 * - Loads are publicly readable, but only the owner (shipper) can modify them.
 * - Bid data is secured via owner-only access by the Carrier.
 *
 * Denormalization for Authorization:
 * - Loads store the shipperId to enable independent authorization.
 * - Bids store the carrierId and loadId to enable independent authorization.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description: Allows users to manage their own profile data.
     * @path: /users/{userId}
     * @allow: (create) User 'user_abc' can create their profile if request.auth.uid == 'user_abc'.
     * @allow: (update) User 'user_abc' can update their profile if request.auth.uid == 'user_abc'.
     * @allow: (get) User 'user_abc' can read their profile if request.auth.uid == 'user_abc'.
     * @deny: (create) User 'user_xyz' cannot create a profile with ID 'user_abc'.
     * @deny: (update) User 'user_xyz' cannot update profile 'user_abc'.
     * @principle: Enforces user-ownership for profile data.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && resource.data.id == userId;
      allow delete: if false;
    }

    /**
     * @description: Allows users to manage their own verification documents.
     * @path: /users/{userId}/verification_documents/{documentId}
     * @allow: (create) User 'user_abc' can create a document under their ID.
     * @allow: (update) User 'user_abc' can update a document under their ID.
     * @allow: (get) User 'user_abc' can read a document under their ID.
     * @deny: (create) User 'user_xyz' cannot create a document under user 'user_abc'.
     * @deny: (update) User 'user_xyz' cannot update a document under user 'user_abc'.
     * @principle: Enforces path-based ownership for user documents.
     */
    match /users/{userId}/verification_documents/{documentId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description: Allows users to manage their own subscription information.
     * @path: /users/{userId}/subscriptions/{subscriptionId}
     * @allow: (create) User 'user_abc' can create a subscription under their ID.
     * @allow: (update) User 'user_abc' can update a subscription under their ID.
     * @allow: (get) User 'user_abc' can read a subscription under their ID.
     * @deny: (create) User 'user_xyz' cannot create a subscription under user 'user_abc'.
     * @deny: (update) User 'user_xyz' cannot update a subscription under user 'user_abc'.
     * @principle: Enforces path-based ownership for user subscriptions.
     */
    match /users/{userId}/subscriptions/{subscriptionId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description: Allows drivers to manage their own profile data.
     * @path: /drivers/{driverId}
     * @allow: (create) Driver 'driver_abc' can create their profile if request.auth.uid == 'driver_abc'.
     * @allow: (update) Driver 'driver_abc' can update their profile if request.auth.uid == 'driver_abc'.
     * @allow: (get) Driver 'driver_abc' can read their profile if request.auth.uid == 'driver_abc'.
     * @deny: (create) User 'user_xyz' cannot create a driver profile with ID 'driver_abc'.
     * @deny: (update) User 'user_xyz' cannot update driver profile 'driver_abc'.
     * @principle: Enforces user-ownership for driver profile data.
     */
    match /drivers/{driverId} {
      function isOwner(driverId) {
        return request.auth.uid == driverId;
      }
      
      allow get: if isOwner(driverId);
      allow list: if false;
      allow create: if isOwner(driverId);
      allow update: if isOwner(driverId);
      allow delete: if isOwner(driverId);
    }

    /**
     * @description: Allows drivers to manage their own truck data.
     * @path: /drivers/{driverId}/trucks/{truckId}
     * @allow: (create) Driver 'driver_abc' can create a truck under their ID.
     * @allow: (update) Driver 'driver_abc' can update a truck under their ID.
     * @allow: (get) Driver 'driver_abc' can read a truck under their ID.
     * @deny: (create) User 'user_xyz' cannot create a truck under driver 'driver_abc'.
     * @deny: (update) User 'user_xyz' cannot update a truck under driver 'driver_abc'.
     * @principle: Enforces path-based ownership for truck data.
     */
    match /drivers/{driverId}/trucks/{truckId} {
      function isOwner(driverId) {
        return request.auth.uid == driverId;
      }
      
      allow get: if isOwner(driverId);
      allow list: if isOwner(driverId);
      allow create: if isOwner(driverId);
      allow update: if isOwner(driverId);
      allow delete: if isOwner(driverId);
    }

    /**
     * @description: Allows any user to read load data, but only the owner (shipper) to modify it.
     * @path: /loads/{loadId}
     * @allow: (get) Any user can read load 'load_123'.
     * @allow: (list) Any user can list loads.
     * @allow: (create) Shipper 'shipper_abc' can create a load with shipperId == 'shipper_abc'.
     * @allow: (update) Shipper 'shipper_abc' can update load 'load_123' if resource.data.shipperId == 'shipper_abc'.
     * @deny: (create) Shipper 'shipper_xyz' cannot create a load with shipperId != 'shipper_xyz'.
     * @deny: (update) Shipper 'shipper_xyz' cannot update load 'load_123' owned by 'shipper_abc'.
     * @principle: Enforces public-read, owner-write for loads. Denormalizes shipperId for authorization.
     */
    match /loads/{loadId} {
        function isOwner(shipperId) {
            return request.auth.uid == shipperId;
        }
        
        allow get, list: if true;
        allow create: if isOwner(request.resource.data.shipperId);
        allow update: if isOwner(resource.data.shipperId);
        allow delete: if isOwner(resource.data.shipperId);
    }

    /**
     * @description: Allows the carrier who created the bid to manage it.
     * @path: /loads/{loadId}/bids/{bidId}
     * @allow: (create) Carrier 'carrier_abc' can create a bid for load 'load_123' if request.auth.uid == 'carrier_abc'.
     * @allow: (update) Carrier 'carrier_abc' can update bid 'bid_456' if resource.data.carrierId == 'carrier_abc'.
     * @allow: (get) Carrier 'carrier_abc' can read bid 'bid_456' if resource.data.carrierId == 'carrier_abc'.
     * @deny: (create) Carrier 'carrier_xyz' cannot create a bid for load 'load_123' using 'carrier_abc's identity.
     * @deny: (update) Carrier 'carrier_xyz' cannot update bid 'bid_456' owned by 'carrier_abc'.
     * @principle: Enforces owner-only access for bids, denormalizing carrierId for authorization.
     */
    match /loads/{loadId}/bids/{bidId} {
      function isOwner(carrierId) {
        return request.auth.uid == carrierId;
      }

      allow get: if isOwner(resource.data.carrierId);
      allow list: if false;
      allow create: if isOwner(request.resource.data.carrierId);
      allow update: if isOwner(resource.data.carrierId);
      allow delete: if isOwner(resource.data.carrierId);
    }

    /**
     * @description: Allows access to emergency alerts for a specific truck.
     * @path: /trucks/{truckId}/emergency_alerts/{alertId}
     * @allow: TODO: Define which roles/users are permitted to access emergency alerts
     * @deny: No access currently defined.
     * @principle: Enforces ... (Define the access control principle)
     */
    match /trucks/{truckId}/emergency_alerts/{alertId} {
      allow get: if false; // TODO: Define which roles/users are permitted to access emergency alerts
      allow list: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description: Allows shippers to manage their own profile data.
     * @path: /shippers/{shipperId}
     * @allow: (create) Shipper 'shipper_abc' can create their profile if request.auth.uid == 'shipper_abc'.
     * @allow: (update) Shipper 'shipper_abc' can update their profile if request.auth.uid == 'shipper_abc'.
     * @allow: (get) Shipper 'shipper_abc' can read their profile if request.auth.uid == 'shipper_abc'.
     * @deny: (create) User 'user_xyz' cannot create a shipper profile with ID 'shipper_abc'.
     * @deny: (update) User 'user_xyz' cannot update shipper profile 'shipper_abc'.
     * @principle: Enforces user-ownership for shipper profile data.
     */
    match /shippers/{shipperId} {
      function isOwner(shipperId) {
        return request.auth.uid == shipperId;
      }

      allow get: if isOwner(shipperId);
      allow list: if false;
      allow create: if isOwner(shipperId);
      allow update: if isOwner(shipperId);
      allow delete: if isOwner(shipperId);
    }

    /**
     * @description: Allows carriers to manage their own profile data.
     * @path: /carriers/{carrierId}
     * @allow: (create) Carrier 'carrier_abc' can create their profile if request.auth.uid == 'carrier_abc'.
     * @allow: (update) Carrier 'carrier_abc' can update their profile if request.auth.uid == 'carrier_abc'.
     * @allow: (get) Carrier 'carrier_abc' can read their profile if request.auth.uid == 'carrier_abc'.
     * @deny: (create) User 'user_xyz' cannot create a carrier profile with ID 'carrier_abc'.
     * @deny: (update) User 'user_xyz' cannot update carrier profile 'carrier_abc'.
     * @principle: Enforces user-ownership for carrier profile data.
     */
    match /carriers/{carrierId} {
      function isOwner(carrierId) {
        return request.auth.uid == carrierId;
      }

      allow get: if isOwner(carrierId);
      allow list: if false;
      allow create: if isOwner(carrierId);
      allow update: if isOwner(carrierId);
      allow delete: if isOwner(carrierId);
    }

    /**
     * @description: Allows freight managers to manage their own profile data.
     * @path: /freight_managers/{freightManagerId}
     * @allow: (create) FreightManager 'freight_manager_abc' can create their profile if request.auth.uid == 'freight_manager_abc'.
     * @allow: (update) FreightManager 'freight_manager_abc' can update their profile if request.auth.uid == 'freight_manager_abc'.
     * @allow: (get) FreightManager 'freight_manager_abc' can read their profile if request.auth.uid == 'freight_manager_abc'.
     * @deny: (create) User 'user_xyz' cannot create a freight manager profile with ID 'freight_manager_abc'.
     * @deny: (update) User 'user_xyz' cannot update freight manager profile 'freight_manager_abc'.
     * @principle: Enforces user-ownership for freight manager profile data.
     */
    match /freight_managers/{freightManagerId} {
      function isOwner(freightManagerId) {
        return request.auth.uid == freightManagerId;
      }

      allow get: if isOwner(freightManagerId);
      allow list: if false;
      allow create: if isOwner(freightManagerId);
      allow update: if isOwner(freightManagerId);
      allow delete: if isOwner(freightManagerId);
    }
  }
}