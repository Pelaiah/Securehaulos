/**
 * @fileoverview Firestore Security Rules for SecureHaul application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for personal data while allowing controlled access to shared resources. Authorization independence is achieved through data denormalization.
 *
 * Data Structure:
 * - User profiles and associated data (verification documents, subscriptions) are nested under `/users/{userId}`.
 * - Driver profiles and trucks are nested under `/drivers/{driverId}`.
 * - Load postings are stored in a top-level `/loads` collection.
 * - Bids for loads are stored as subcollections under `/loads/{loadId}/bids/{bidId}`.
 *
 * Key Security Decisions:
 * - User listing is disallowed.
 * - Read-only collections are not used in this version.
 * - All write operations require authentication.
 * - To avoid costly `get()` calls in rules, `shipperId` is denormalized into `Load` documents, and `carrierId` and `loadId` are denormalized into the `Bid` documents.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is authenticated.
     * @path N/A
     * @allow N/A
     * @deny N/A
     * @principle Authentication is required for most operations.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user ID matches the provided user ID.
     * @path N/A
     * @allow N/A
     * @deny N/A
     * @principle Enforces user-based ownership.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user owns the existing document.
     * @path N/A
     * @allow N/A
     * @deny N/A
     * @principle Combines ownership and existence checks for destructive operations.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Rule for the /users/{userId} collection.
     * @path /users/{userId}
     * @allow (create) - User with ID 'user123' can create their profile if authenticated as 'user123'.
     * @deny (create) - User with ID 'user123' cannot create a profile if authenticated as 'user456'.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;

      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rule for the /users/{userId}/verification_documents/{documentId} subcollection.
     * @path /users/{userId}/verification_documents/{documentId}
     * @allow (create) - User with ID 'user123' can create a verification document under their profile.
     * @deny (create) - User with ID 'user123' cannot create a verification document under 'user456' profile.
     * @principle Enforces path-based ownership.
     */
    match /users/{userId}/verification_documents/{documentId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rule for the /users/{userId}/subscriptions/{subscriptionId} subcollection.
     * @path /users/{userId}/subscriptions/{subscriptionId}
     * @allow (create) - User with ID 'user123' can create a subscription under their profile.
     * @deny (create) - User with ID 'user123' cannot create a subscription under 'user456' profile.
     * @principle Enforces path-based ownership.
     */
    match /users/{userId}/subscriptions/{subscriptionId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rule for the /drivers/{driverId} collection.
     * @path /drivers/{driverId}
     * @allow (create) - User with ID 'driver123' can create their profile if authenticated as 'driver123'.
     * @deny (create) - User with ID 'driver123' cannot create a profile if authenticated as 'user456'.
     * @principle Enforces document ownership for writes.
     */
    match /drivers/{driverId} {
      allow get: if isOwner(driverId);
      allow list: if false;

      allow create: if isOwner(driverId);
      allow update: if isExistingOwner(driverId);
      allow delete: if isExistingOwner(driverId);
    }

    /**
     * @description Rule for the /drivers/{driverId}/trucks/{truckId} subcollection.
     * @path /drivers/{driverId}/trucks/{truckId}
     * @allow (create) - User with ID 'driver123' can create a truck under their profile.
     * @deny (create) - User with ID 'driver123' cannot create a truck under 'user456' profile.
     * @principle Enforces path-based ownership.
     */
    match /drivers/{driverId}/trucks/{truckId} {
      allow get: if isOwner(driverId);
      allow list: if isOwner(driverId);

      allow create: if isOwner(driverId);
      allow update: if isExistingOwner(driverId);
      allow delete: if isExistingOwner(driverId);
    }

    /**
     * @description Rule for the /loads/{loadId} collection.
     * @path /loads/{loadId}
     * @allow (get, list) - Any user can read load postings.
     * @allow (create) - Authenticated users can create load postings with their user ID in the shipperId field.
     * @deny (create) - Creation is denied if the shipperId field does not match the authenticated user's ID.
     * @principle Public read with owner-only writes, enforcing shipper ownership.
     */
    match /loads/{loadId} {
      allow get, list: if true;

      allow create: if isSignedIn() && request.resource.data.shipperId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.shipperId == request.auth.uid && resource != null;
      allow delete: if isSignedIn() && resource.data.shipperId == request.auth.uid && resource != null;
    }

    /**
     * @description Rule for the /loads/{loadId}/bids/{bidId} subcollection.
     * @path /loads/{loadId}/bids/{bidId}
     * @allow (get, list) - Any user can read bids for a load.
     * @allow (create) - Authenticated users can create bids with their user ID in the carrierId field.
     * @deny (create) - Creation is denied if the carrierId field does not match the authenticated user's ID.
     * @principle Public read with owner-only writes, enforcing carrier ownership.
     */
    match /loads/{loadId}/bids/{bidId} {
      allow get, list: if true;

      allow create: if isSignedIn() && request.resource.data.carrierId == request.auth.uid && request.resource.data.loadId == loadId;
      allow update: if isSignedIn() && resource.data.carrierId == request.auth.uid && resource.data.loadId == loadId && resource != null;
      allow delete: if isSignedIn() && resource.data.carrierId == request.auth.uid && resource.data.loadId == loadId && resource != null;
    }

    /**
     * @description Rule for the /trucks/{truckId}/emergency_alerts/{alertId} subcollection.
     * @path /trucks/{truckId}/emergency_alerts/{alertId}
     * @allow (get, list) - Any user can read emergency alerts.
     * @allow (create) - Authenticated users can create emergency alerts for a truck if the truck exists.
     * @principle Public read, authenticated creation.
     */
    match /trucks/{truckId}/emergency_alerts/{alertId} {
      allow get, list: if true;

      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Rule for the /shippers/{shipperId} collection.
     * @path /shippers/{shipperId}
     * @allow (create) - User with ID 'shipper123' can create their profile if authenticated as 'shipper123'.
     * @deny (create) - User with ID 'shipper123' cannot create a profile if authenticated as 'user456'.
     * @principle Enforces document ownership for writes.
     */
    match /shippers/{shipperId} {
      allow get: if isOwner(shipperId);
      allow list: if false;

      allow create: if isOwner(shipperId);
      allow update: if isExistingOwner(shipperId);
      allow delete: if isExistingOwner(shipperId);
    }

    /**
     * @description Rule for the /carriers/{carrierId} collection.
     * @path /carriers/{carrierId}
     * @allow (create) - User with ID 'carrier123' can create their profile if authenticated as 'carrier123'.
     * @deny (create) - User with ID 'carrier123' cannot create a profile if authenticated as 'user456'.
     * @principle Enforces document ownership for writes.
     */
    match /carriers/{carrierId} {
      allow get: if isOwner(carrierId);
      allow list: if false;

      allow create: if isOwner(carrierId);
      allow update: if isExistingOwner(carrierId);
      allow delete: if isExistingOwner(carrierId);
    }

    /**
     * @description Rule for the /freight_managers/{freightManagerId} collection.
     * @path /freight_managers/{freightManagerId}
     * @allow (create) - User with ID 'freightManager123' can create their profile if authenticated as 'freightManager123'.
     * @deny (create) - User with ID 'freightManager123' cannot create a profile if authenticated as 'user456'.
     * @principle Enforces document ownership for writes.
     */
    match /freight_managers/{freightManagerId} {
      allow get: if isOwner(freightManagerId);
      allow list: if false;

      allow create: if isOwner(freightManagerId);
      allow update: if isExistingOwner(freightManagerId);
      allow delete: if isExistingOwner(freightManagerId);
    }
  }
}