/**
 * @fileOverview Firestore Security Rules for the SecureHaul application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for personal data and a
 * public-read/owner-write model for shared data. Data is denormalized to avoid
 * complex queries in rules and ensure authorization independence.
 *
 * Data Structure:
 * - /users/{userId}: User profiles, owned by the user.
 * - /users/{userId}/verification_documents/{documentId}: Verification documents, owned by the user.
 * - /users/{userId}/subscriptions/{subscriptionId}: Subscription information, owned by the user.
 * - /drivers/{driverId}: Driver profiles, owned by the user.
 * - /drivers/{driverId}/trucks/{truckId}: Trucks owned by the driver.
 * - /loads/{loadId}: Load postings, owned by the shipper (shipperId denormalized in the document).
 * - /loads/{loadId}/bids/{bidId}: Bids on loads, associated with a carrier (carrierId and loadId denormalized in the document).
 * - /trucks/{truckId}/emergency_alerts/{alertId}: Emergency alerts for trucks.
 * - /shippers/{shipperId}: Shipper profiles, owned by the user.
 * - /carriers/{carrierId}: Carrier profiles, owned by the user.
 * - /freight_managers/{freightManagerId}: Freight manager profiles, owned by the user.
 *
 * Key Security Decisions:
 * - User data is strictly controlled by the user.
 * - Listing of user subcollections is allowed only for the owner.
 * - Loads are publicly readable, but only the owner can create/update/delete.
 * - Bids are only writable if the bid includes the right carrierId and loadId, and readable by anyone.
 *
 * Denormalization for Authorization:
 * - Loads include `shipperId` to authorize updates/deletes without additional reads.
 * - Bids include `carrierId` and `loadId` to authorize writes without additional reads.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the requesting user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the requesting user is the owner of the resource.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the requesting user is the existing owner of the resource.
     */
    function isExistingOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Enforces that the new document contains the correct owner ID.
     */
    function isValidOwnerIdOnCreate(userId) {
      return request.resource.data.id == userId;
    }

    /**
     * @description Enforces that the owner ID cannot be changed after creation.
     */
    function isValidOwnerIdOnUpdate(userId) {
      return request.resource.data.id == resource.data.id;
    }

    /**
     * @description Rules for the /users/{userId} collection.
     * @path /users/{userId}
     * @allow (create) User 'test_user' with ID 'test_user' can create their profile.
     * @deny (create) User 'test_user' cannot create a profile with ID 'another_user'.
     * @principle Enforces document ownership for writes, self-creation
     */
    match /users/{userId} {
      // Only allow a user to create their own profile.
      allow create: if isOwner(userId);
      allow get: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
      allow list: if false;
    }

    /**
     * @description Rules for the /users/{userId}/verification_documents/{documentId} collection.
     * @path /users/{userId}/verification_documents/{documentId}
     * @allow (create) User 'test_user' can create a verification document in their own profile.
     * @deny (create) User 'test_user' cannot create a verification document in another user's profile.
     * @principle Enforces document ownership for writes, restricts access to a user's own data tree.
     */
    match /users/{userId}/verification_documents/{documentId} {
      allow create: if isOwner(userId);
      allow get: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
      allow list: if isOwner(userId);
    }

    /**
     * @description Rules for the /users/{userId}/subscriptions/{subscriptionId} collection.
     * @path /users/{userId}/subscriptions/{subscriptionId}
     * @allow (create) User 'test_user' can create a subscription in their own profile.
     * @deny (create) User 'test_user' cannot create a subscription in another user's profile.
     * @principle Enforces document ownership for writes, restricts access to a user's own data tree.
     */
    match /users/{userId}/subscriptions/{subscriptionId} {
      allow create: if isOwner(userId);
      allow get: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
      allow list: if isOwner(userId);
    }

    /**
     * @description Rules for the /drivers/{driverId} collection.
     * @path /drivers/{driverId}
     * @allow (create) Driver 'test_driver' can create their profile.
     * @deny (create) Driver 'test_driver' cannot create a profile with ID 'another_driver'.
     * @principle Enforces document ownership for writes, self-creation.
     */
    match /drivers/{driverId} {
      allow create: if isOwner(driverId);
      allow get: if isOwner(driverId);
      allow update: if isOwner(driverId);
      allow delete: if isOwner(driverId);
      allow list: if false;
    }

    /**
     * @description Rules for the /drivers/{driverId}/trucks/{truckId} collection.
     * @path /drivers/{driverId}/trucks/{truckId}
     * @allow (create) Driver 'test_driver' can create a truck in their own profile.
     * @deny (create) Driver 'test_driver' cannot create a truck in another driver's profile.
     * @principle Enforces document ownership for writes, restricts access to a user's own data tree.
     */
    match /drivers/{driverId}/trucks/{truckId} {
      allow create: if isOwner(driverId);
      allow get: if isOwner(driverId);
      allow update: if isOwner(driverId);
      allow delete: if isOwner(driverId);
      allow list: if isOwner(driverId);
    }

    /**
     * @description Rules for the /loads/{loadId} collection.
     * @path /loads/{loadId}
     * @allow (get, list) Any user can read load information.
     * @allow (create) Shipper 'test_shipper' can create a load with shipperId equal to their own ID.
     * @deny (create) Shipper 'test_shipper' cannot create a load with shipperId equal to another user's ID.
     * @principle Public read with owner-only writes, validates relational integrity between documents.
     */
    match /loads/{loadId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.shipperId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.shipperId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.shipperId == request.auth.uid;
    }

    /**
     * @description Rules for the /loads/{loadId}/bids/{bidId} collection.
     * @path /loads/{loadId}/bids/{bidId}
     * @allow (create) Carrier 'test_carrier' can create a bid for a load.
     * @deny (create) Carrier 'test_carrier' cannot create a bid for a load with incorrect carrierId or loadId.
     * @principle Validates relational integrity between documents, owner-only writes.
     */
    match /loads/{loadId}/bids/{bidId} {
      allow create: if isSignedIn() && request.resource.data.carrierId == request.auth.uid && request.resource.data.loadId == loadId;
      allow get: if true;
      allow update: if false;
      allow delete: if false;
      allow list: if true;
    }

    /**
     * @description Rules for the /trucks/{truckId}/emergency_alerts/{alertId} collection.
     * @path /trucks/{truckId}/emergency_alerts/{alertId}
     */
    match /trucks/{truckId}/emergency_alerts/{alertId} {
      allow create: if true;
      allow get: if true;
      allow update: if false;
      allow delete: if false;
      allow list: if true;
    }

    /**
     * @description Rules for the /shippers/{shipperId} collection.
     * @path /shippers/{shipperId}
     */
    match /shippers/{shipperId} {
      allow create: if isOwner(shipperId);
      allow get: if isOwner(shipperId);
      allow update: if isOwner(shipperId);
      allow delete: if isOwner(shipperId);
      allow list: if false;
    }

    /**
     * @description Rules for the /carriers/{carrierId} collection.
     * @path /carriers/{carrierId}
     */
    match /carriers/{carrierId} {
      allow create: if isOwner(carrierId);
      allow get: if isOwner(carrierId);
      allow update: if isOwner(carrierId);
      allow delete: if isOwner(carrierId);
      allow list: if false;
    }

    /**
     * @description Rules for the /freight_managers/{freightManagerId} collection.
     * @path /freight_managers/{freightManagerId}
     */
    match /freight_managers/{freightManagerId} {
      allow create: if isOwner(freightManagerId);
      allow get: if isOwner(freightManagerId);
      allow update: if isOwner(freightManagerId);
      allow delete: if isOwner(freightManagerId);
      allow list: if false;
    }
  }
}